---
import PublicLayout from '../../layouts/PublicLayout.astro';

const db = Astro.locals.runtime?.env?.DB;

interface Marker {
  id: number;
  name: string;
  color: string;
  text_color: string;
  display_order: number;
}

interface ChartEntry {
  marker_id: number;
  row_order: number;
  handicap_range: string;
  course_handicap: string;
  index_min: number;
  index_max: number;
}

let markers: Marker[] = [];
let entries: ChartEntry[] = [];

if (db) {
  const [mResult, eResult] = await Promise.all([
    db.prepare('SELECT * FROM handicap_markers ORDER BY display_order').all<Marker>(),
    db.prepare('SELECT marker_id, row_order, handicap_range, course_handicap, index_min, index_max FROM handicap_chart_entries ORDER BY marker_id, row_order').all<ChartEntry>(),
  ]);
  markers = mResult.results ?? [];
  entries = eResult.results ?? [];
}

const entriesByMarker: Record<number, ChartEntry[]> = {};
for (const e of entries) {
  if (!entriesByMarker[e.marker_id]) entriesByMarker[e.marker_id] = [];
  entriesByMarker[e.marker_id].push(e);
}
---

<PublicLayout
  title="Course Handicapping"
  description="Course handicap conversion charts for all tee markers at Alnmouth Village Golf Club."
  heroTitle="Course Handicapping"
  heroSubtitle="Convert your Handicap Index to a Course Handicap for any tee"
>
  <div class="content">
    <section class="section hcp-section">

      <div class="section-header">
        <h2 class="section-title">Course Handicap Chart</h2>
        <p class="section-subtitle">
          Select your tee marker, then enter your Handicap Index® to find your Course Handicap™.
        </p>
      </div>

      <div class="hcp-card">

        <!-- Custom marker dropdown -->
        <div class="field-group">
          <label class="field-label" id="marker-label">Tee marker</label>
          <div class="custom-select" id="marker-dropdown" role="combobox" aria-labelledby="marker-label" aria-haspopup="listbox" aria-expanded="false">
            <button class="custom-select-btn" id="marker-btn" type="button">
              <span class="btn-dot" id="btn-dot"></span>
              <span class="btn-label" id="btn-label"></span>
              <svg class="select-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="custom-select-list" id="marker-list" role="listbox" aria-labelledby="marker-label">
              {markers.map((m, i) => (
                <li
                  class="custom-option"
                  role="option"
                  data-id={m.id}
                  data-color={m.color}
                  data-text-color={m.text_color}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex="-1"
                >
                  <span class="option-dot" style={`background:${m.color};border-color:${m.color === '#FFFFFF' ? '#ccc' : m.color}`}></span>
                  {m.name}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Handicap index lookup -->
        <div class="field-group">
          <label for="hcp-input" class="field-label">Your Handicap Index®</label>
          <div class="lookup-row">
            <input
              type="text"
              id="hcp-input"
              class="hcp-input"
              placeholder="e.g. 12.4 or +2.1"
              inputmode="decimal"
              autocomplete="off"
            />
            <button class="btn btn-primary lookup-btn" id="lookup-btn">Lookup Course Handicap</button>
            <button class="btn btn-outline lookup-clear" id="lookup-clear" style="display:none">Clear</button>
          </div>
          <p class="lookup-hint" id="lookup-hint" aria-live="polite"></p>
        </div>

        <!-- Chart table -->
        <div class="chart-wrapper" id="chart-wrapper">
          <div class="chart-scroll">
            <table class="chart-table">
              <thead id="chart-thead">
                <tr>
                  <th colspan="3">Handicap Index®</th>
                  <th>Course Handicap™</th>
                </tr>
              </thead>
              <tbody id="chart-body">
                <tr><td colspan="4" class="chart-empty">Loading…</td></tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>
  </div>
</PublicLayout>

<script define:vars={{ markersData: markers, entriesData: entriesByMarker }}>
  const markers = markersData;
  const entriesByMarker = entriesData;

  // Elements
  const dropdown   = document.getElementById('marker-dropdown');
  const markerBtn  = document.getElementById('marker-btn');
  const btnDot     = document.getElementById('btn-dot');
  const btnLabel   = document.getElementById('btn-label');
  const markerList = document.getElementById('marker-list');
  const tbody      = document.getElementById('chart-body');
  const thead      = document.getElementById('chart-thead');
  const chartWrapper = document.getElementById('chart-wrapper');
  const hcpInput   = document.getElementById('hcp-input');
  const lookupBtn  = document.getElementById('lookup-btn');
  const lookupClear = document.getElementById('lookup-clear');
  const lookupHint = document.getElementById('lookup-hint');

  let currentMarkerId = null;
  let highlightedRow = null;   // track so we can clear inline styles

  // ── Utilities ──────────────────────────────────────────
  function hexToRgba(hex, alpha) {
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    return `rgba(${r},${g},${b},${alpha})`;
  }

  function parseUserHcp(s) {
    const t = s.trim();
    if (t.startsWith('+')) return -parseFloat(t.slice(1));
    return parseFloat(t);
  }

  // ── Dropdown ───────────────────────────────────────────
  function openDropdown() {
    dropdown.setAttribute('aria-expanded', 'true');
    markerList.classList.add('open');
    // Scroll active option into view
    const active = markerList.querySelector('[aria-selected="true"]');
    active?.scrollIntoView({ block: 'nearest' });
  }

  function closeDropdown(returnFocus = false) {
    dropdown.setAttribute('aria-expanded', 'false');
    markerList.classList.remove('open');
    if (returnFocus) markerBtn.focus();
  }

  function selectMarker(option) {
    const id = parseInt(option.dataset.id);
    markerList.querySelectorAll('.custom-option').forEach(o =>
      o.setAttribute('aria-selected', o === option ? 'true' : 'false')
    );
    btnDot.style.background = option.dataset.color;
    btnDot.style.borderColor = option.dataset.color === '#FFFFFF' ? '#ccc' : option.dataset.color;
    btnLabel.textContent = option.textContent.trim();

    closeDropdown(true);
    if (id !== currentMarkerId) {
      currentMarkerId = id;
      clearHighlight();
      renderChart(id);
    }
  }

  markerBtn.addEventListener('click', () => {
    markerList.classList.contains('open') ? closeDropdown(true) : openDropdown();
  });

  markerList.addEventListener('click', e => {
    const opt = e.target.closest('.custom-option');
    if (opt) selectMarker(opt);
  });

  // Close on outside click — do NOT steal focus
  document.addEventListener('click', e => {
    if (!dropdown.contains(e.target)) closeDropdown(false);
  });

  // Keyboard navigation
  markerBtn.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') {
      e.preventDefault();
      openDropdown();
      markerList.querySelector('[aria-selected="true"]')?.focus();
    }
  });

  markerList.addEventListener('keydown', e => {
    const opts = [...markerList.querySelectorAll('.custom-option')];
    const focused = document.activeElement;
    const idx = opts.indexOf(focused);
    if (e.key === 'ArrowDown') { e.preventDefault(); opts[Math.min(idx + 1, opts.length - 1)]?.focus(); }
    if (e.key === 'ArrowUp')   { e.preventDefault(); idx > 0 ? opts[idx - 1].focus() : closeDropdown(true); }
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); if (focused?.classList.contains('custom-option')) selectMarker(focused); }
    if (e.key === 'Escape')    { closeDropdown(true); }
  });

  // ── Chart rendering ────────────────────────────────────
  function applyMarkerTheme(marker) {
    const { color, text_color } = marker;
    btnDot.style.background = color;
    btnDot.style.borderColor = color === '#FFFFFF' ? '#ccc' : color;
    thead.querySelectorAll('th').forEach(th => {
      th.style.background = color;
      th.style.color = text_color;
    });
  }

  function renderChart(markerId) {
    const marker = markers.find(m => m.id === markerId);
    if (!marker) return;

    applyMarkerTheme(marker);

    const rows = entriesByMarker[markerId] || [];
    if (rows.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:#888;padding:2rem;font-style:italic">No data available for this marker.</td></tr>';
      return;
    }

    // Compute alternating tint inline — bypasses Astro CSS scoping on injected rows
    const tint = marker.color === '#FFFFFF' ? 'rgba(0,0,0,0.04)' : hexToRgba(marker.color, 0.18);

    tbody.innerHTML = rows.map((r, i) => {
      const parts = r.handicap_range.split(' to ');
      const from = parts[0] ?? r.handicap_range;
      const to   = parts[1] ?? '';
      const rowBg = i % 2 === 0 ? tint : '';
      return `<tr data-min="${r.index_min}" data-max="${r.index_max}" style="background:${rowBg};border-bottom:1px solid #eee">
        <td class="range-from" style="text-align:right;font-weight:600;padding:0.32rem 0.3rem 0.32rem 0.75rem;width:30%">${from}</td>
        <td class="range-sep" style="text-align:center;color:#999;font-size:0.8rem;padding:0.32rem 0;width:8%">to</td>
        <td class="range-to" style="text-align:left;font-weight:600;padding:0.32rem 0.5rem 0.32rem 0.3rem;width:28%">${to}</td>
        <td class="ch-cell" style="text-align:center;font-weight:700;font-size:0.95rem;color:#2d5a3d;padding:0.32rem 0.75rem 0.32rem 0.3rem;width:34%">${r.course_handicap}</td>
      </tr>`;
    }).join('');

    if (hcpInput.value.trim()) highlightRow(hcpInput.value);
  }

  // ── Lookup ─────────────────────────────────────────────
  function applyHighlightStyles(row, marker) {
    row.style.background = '#fffbea';
    const fromCell = row.querySelector('.range-from');
    const sepCell  = row.querySelector('.range-sep');
    const toCell   = row.querySelector('.range-to');
    const chCell   = row.querySelector('.ch-cell');
    if (fromCell) { fromCell.style.color = '#7a5200'; fromCell.style.fontWeight = '700'; fromCell.style.borderLeft = '4px solid #f0c040'; fromCell.style.paddingLeft = 'calc(0.75rem - 4px)'; }
    if (sepCell)  { sepCell.style.color = '#a07820'; }
    if (toCell)   { toCell.style.color = '#7a5200'; toCell.style.fontWeight = '700'; }
    if (chCell)   {
      chCell.style.background = marker.color;
      chCell.style.color = marker.text_color;
      chCell.style.fontWeight = '800';
      chCell.style.fontSize = '1.1rem';
    }
  }

  function removeHighlightStyles(row) {
    // Restore to the inline styles set during renderChart
    const i = [...tbody.querySelectorAll('tr')].indexOf(row);
    const marker = markers.find(m => m.id === currentMarkerId);
    const tint = marker && marker.color !== '#FFFFFF' ? hexToRgba(marker.color, 0.18) : 'rgba(0,0,0,0.04)';
    row.style.background = i % 2 === 0 ? tint : '';
    const fromCell = row.querySelector('.range-from');
    const sepCell  = row.querySelector('.range-sep');
    const toCell   = row.querySelector('.range-to');
    const chCell   = row.querySelector('.ch-cell');
    if (fromCell) { fromCell.style.color = ''; fromCell.style.fontWeight = '600'; fromCell.style.borderLeft = ''; fromCell.style.paddingLeft = '0.75rem'; }
    if (sepCell)  { sepCell.style.color = '#999'; }
    if (toCell)   { toCell.style.color = ''; toCell.style.fontWeight = '600'; }
    if (chCell)   { chCell.style.background = ''; chCell.style.color = '#2d5a3d'; chCell.style.fontWeight = '700'; chCell.style.fontSize = '0.95rem'; }
  }

  function highlightRow(inputVal) {
    const numeric = parseUserHcp(inputVal);
    if (isNaN(numeric)) {
      lookupHint.textContent = 'Please enter a valid Handicap Index, e.g. 12.4 or +2.1';
      lookupHint.style.color = '#c0392b';
      return;
    }

    if (highlightedRow) { removeHighlightStyles(highlightedRow); highlightedRow = null; }

    const marker = markers.find(m => m.id === currentMarkerId);
    let found = null;
    tbody.querySelectorAll('tr').forEach(row => {
      const lo = parseFloat(row.dataset.min);
      const hi = parseFloat(row.dataset.max);
      if (numeric >= lo && numeric <= hi) found = row;
    });

    if (found && marker) {
      applyHighlightStyles(found, marker);
      highlightedRow = found;
      found.scrollIntoView({ behavior: 'smooth', block: 'center' });
      const ch = found.querySelector('.ch-cell')?.textContent || '';
      lookupHint.textContent = `Your Course Handicap on ${marker.name} is ${ch}`;
      lookupHint.style.color = 'var(--primary)';
      lookupHint.style.fontWeight = '600';
      lookupClear.style.display = '';
    } else {
      lookupHint.textContent = 'Handicap Index not found — check the value and try again.';
      lookupHint.style.color = '#c0392b';
      lookupHint.style.fontWeight = '';
    }
  }

  function clearHighlight() {
    if (highlightedRow) { removeHighlightStyles(highlightedRow); highlightedRow = null; }
    hcpInput.value = '';
    lookupHint.textContent = '';
    lookupHint.style.color = '';
    lookupHint.style.fontWeight = '';
    lookupClear.style.display = 'none';
  }

  lookupBtn.addEventListener('click', () => highlightRow(hcpInput.value));
  hcpInput.addEventListener('keydown', e => { if (e.key === 'Enter') highlightRow(hcpInput.value); });
  lookupClear.addEventListener('click', clearHighlight);

  // ── Init ───────────────────────────────────────────────
  if (markers.length > 0) {
    const first = markers[0];
    currentMarkerId = first.id;
    const firstOpt = markerList.querySelector('.custom-option');
    if (firstOpt) {
      btnDot.style.background = firstOpt.dataset.color;
      btnDot.style.borderColor = firstOpt.dataset.color === '#FFFFFF' ? '#ccc' : firstOpt.dataset.color;
      btnLabel.textContent = firstOpt.textContent.trim();
    }
    renderChart(first.id);
  }
</script>

<style>
  .hcp-section {
    padding: 4rem 0 5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-header .section-title { margin-bottom: 0.5rem; }

  .section-subtitle {
    color: var(--text-light);
    font-size: 1.05rem;
  }

  .hcp-card {
    background: var(--white);
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    padding: 1.5rem;
    max-width: 420px;
    margin: 0 auto;
  }

  .field-group { margin-bottom: 1.25rem; }

  .field-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  /* ── Custom dropdown ── */
  .custom-select { position: relative; }

  .custom-select-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem 0.75rem 1rem;
    font-size: 1rem;
    font-family: var(--font-body);
    border: 2px solid var(--border);
    border-radius: 50px;
    background: var(--white);
    cursor: pointer;
    color: var(--text);
    text-align: left;
    transition: border-color 0.2s;
  }

  .custom-select-btn:focus,
  .custom-select[aria-expanded="true"] .custom-select-btn {
    outline: none;
    border-color: var(--primary);
  }

  .btn-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid #ccc;
    flex-shrink: 0;
    transition: background 0.2s;
  }

  .btn-label { flex: 1; }

  .select-chevron {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 0.2s;
  }

  .custom-select[aria-expanded="true"] .select-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown list */
  .custom-select-list {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: var(--white);
    border: 2px solid var(--primary);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    z-index: 100;
    list-style: none;
    margin: 0;
    padding: 0.4rem 0;
    max-height: 320px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .custom-select-list.open { display: block; }

  .custom-option {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 1rem;
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--text);
    transition: background 0.1s;
  }

  .custom-option:hover,
  .custom-option:focus {
    background: var(--surface);
    outline: none;
  }

  .custom-option[aria-selected="true"] {
    font-weight: 600;
    color: var(--primary);
  }

  .option-dot {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 2px solid #ccc;
    flex-shrink: 0;
  }

  /* ── Lookup ── */
  .lookup-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .hcp-input {
    flex: 1;
    min-width: 110px;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    font-family: var(--font-body);
    border: 2px solid var(--border);
    border-radius: 50px;
    color: var(--text);
    transition: border-color 0.2s;
  }

  .hcp-input:focus {
    outline: none;
    border-color: var(--primary);
  }

  .lookup-btn, .lookup-clear { white-space: nowrap; }
  .lookup-clear { padding: 0.75rem 1.25rem; }

  .lookup-hint {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    min-height: 1.3em;
    color: var(--text-muted);
  }

  .hint-success { color: var(--primary); font-weight: 600; }
  .hint-error   { color: #c0392b; }

  /* ── Chart ── */
  .chart-wrapper {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-light);
    --row-tint: rgba(0,0,0,0.04);
  }

  .chart-scroll {
    max-height: 55vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .chart-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    table-layout: fixed;
  }

  .chart-table thead th {
    padding: 0.35rem 0.5rem;
    font-weight: 700;
    font-size: 0.82rem;
    text-align: center;
    position: sticky;
    top: 0;
    z-index: 1;
    line-height: 1.25;
  }

  .chart-table thead th:first-child { text-align: left; padding-left: 0.75rem; }
  .chart-table thead th:last-child  { text-align: center; padding-right: 0.75rem; }

  /* Row styles are applied inline via JS (Astro scoping doesn't reach injected rows) */

  @media (max-width: 520px) {
    .hcp-card { padding: 1.25rem; border-radius: 12px; }
    .chart-scroll { max-height: 50vh; }
    .lookup-btn { font-size: 0.88rem; padding: 0.7rem 1rem; }
  }
</style>

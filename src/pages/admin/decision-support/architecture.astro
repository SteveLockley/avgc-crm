    style sage fill:#1a4a6e,stroke:#0d2d44,color:#fff
    style touchoffice fill:#8b4513,stroke:#5c2d0a,color:#fff
    style clubwise fill:#2e4057,stroke:#1a2a3a,color:#fff
    style brsG fill:#4a6741,stroke:#2d4028,color:#fff
    style crmSys fill:#6e4a1a,stroke:#442d0d,color:#fff
    style financeSys fill:#2d5016,stroke:#1a3a0a,color:#fff`
      },
      crosser: {
        title: 'L5 — Cross-System Entity Relationships',
        code: `erDiagram
    SAGE_LedgerAccount {
        string id
        int nominal_code
        string name
        string ledger_account_type
    }
    SAGE_TaxRate {
        string id

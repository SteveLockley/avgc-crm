    let currentZoom = 1;
    let renderCounter = 0;

    async function show(id) {
      currentZoom = 1;
      document.getElementById('diagram-wrapper').style.transform = 'scale(1)';
      document.querySelectorAll('.diagram-nav button').forEach(b => b.classList.remove('active'));
      document.getElementById('btn-' + id).classList.add('active');

      const d = diagrams[id];
      document.getElementById('diagram-title').textContent = d.title;

      const target = document.getElementById('render-target');
      target.innerHTML = '';
      renderCounter++;
      const elId = 'mermaid-' + renderCounter;
      try {
        const { svg } = await mermaid.render(elId, d.code);
        target.innerHTML = svg;
      } catch (e) {
        target.innerHTML = '<pre style="color:red">' + e.message + '</pre>';
      }
    }

    function updateZoom() {
      document.getElementById('diagram-wrapper').style.transform = 'scale(' + currentZoom + ')';
    }
    function zoomIn() { currentZoom = Math.min(currentZoom + 0.2, 3); updateZoom(); }
    function zoomOut() { currentZoom = Math.max(currentZoom - 0.2, 0.2); updateZoom(); }
    function zoomReset() { currentZoom = 1; updateZoom(); }

    document.addEventListener('wheel', function(e) {
      if (e.ctrlKey) { e.preventDefault(); if (e.deltaY < 0) zoomIn(); else zoomOut(); }
    }, { passive: false });

    show('domain');
  </script>

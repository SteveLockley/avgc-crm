---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const db = Astro.locals.runtime.env.DB;

// All stored card rows with member name
const rowsResult = await db.prepare(`
  SELECT
    cpb.*,
    m.first_name || ' ' || m.surname AS member_name
  FROM customer_purse_balances cpb
  LEFT JOIN members m ON m.id = cpb.member_id
  ORDER BY cpb.last_name, cpb.first_name, cpb.customer_number
`).all().catch(() => ({ results: [] }));

// All non-junior members for the match dropdown
const membersResult = await db.prepare(`
  SELECT id, first_name, surname
  FROM members
  WHERE category NOT LIKE '%Junior%'
  ORDER BY surname, first_name
`).all().catch(() => ({ results: [] }));

// Latest seniors purse balance (current year)
const seniorsPurseRow = await db.prepare(`
  SELECT running_balance, sale_date FROM seniors_purse_entries
  WHERE year = CAST(strftime('%Y', 'now') AS INTEGER)
  ORDER BY sale_date DESC, id DESC LIMIT 1
`).first<{ running_balance: number; sale_date: string }>().catch(() => null);

const allRows  = (rowsResult.results  || []) as any[];
const members  = (membersResult.results || []) as any[];
const seniorsPurseBalance = seniorsPurseRow?.running_balance ?? null;

// Find the seniors card row (customer 1035)
const seniorsCard = allRows.find((r: any) => r.customer_number === 1035);
const seniorsMismatch = seniorsCard && seniorsPurseBalance !== null
  && Math.abs((seniorsCard.account_balance ?? 0) - seniorsPurseBalance) > 0.01;

// Summary stats (exclude dead cards from main totals)
const activeRows    = allRows.filter((r: any) => r.customer_group !== 'Dead Cards');
const deadRows      = allRows.filter((r: any) => r.customer_group === 'Dead Cards' && r.account_balance !== 0);
const nonZeroActive = activeRows.filter((r: any) => r.account_balance !== 0);
const totalActiveBalance = activeRows.reduce((s: number, r: any) => s + (r.account_balance || 0), 0);
const totalDeadBalance   = deadRows.reduce((s: number, r: any) => s + (r.account_balance || 0), 0);

// Last synced time
const lastFetched = allRows.length > 0
  ? allRows.reduce((latest: string, r: any) => (r.fetched_at > latest ? r.fetched_at : latest), '')
  : null;

function fmt(n: number) {
  return new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' }).format(n);
}
function fmtDate(iso: string) {
  if (!iso) return '';
  const d = new Date(iso.replace(' ', 'T'));
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}

---

<AdminLayout title="Customer Purse Balances">
  <div class="cpb-page">

    <!-- Page header -->
    <div class="cpb-page-header">
      <div>
        <h1 class="cpb-title">Customer Purse Balances</h1>
        <p class="cpb-sub">TouchOffice card balances across all customer groups</p>
      </div>
      <div class="cpb-controls">
        <button id="syncBtn" class="cpb-btn cpb-btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <polyline points="23 4 23 10 17 10"/>
            <polyline points="1 20 1 14 7 14"/>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
          </svg>
          <span id="syncLabel">Sync from TouchOffice</span>
        </button>
        <button id="debugBtn" class="cpb-btn cpb-btn-ghost" title="Show raw report structure">Debug</button>
      </div>
    </div>

    <!-- Sync status -->
    <div id="syncStatus" class="cpb-sync-status" style="display:none;">
      <div class="cpb-spinner"></div>
      <span id="syncMessage">Fetching from TouchOffice…</span>
    </div>
    <div id="syncResult" class="cpb-sync-result" style="display:none;"></div>

    <!-- Seniors purse mismatch warning -->
    <div id="seniorsMismatchBanner" class="cpb-mismatch-banner" style={seniorsMismatch ? '' : 'display:none;'}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" style="flex-shrink:0">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
        <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
      <span id="mismatchText">
        {seniorsMismatch
          ? `Seniors' Purse balance mismatch: TouchOffice card shows ${fmt(seniorsCard?.account_balance ?? 0)}, CRM shows ${fmt(seniorsPurseBalance ?? 0)}.`
          : ''}
      </span>
      <button id="syncSeniorsBtn" class="cpb-btn cpb-btn-outline cpb-btn-sm">Sync Seniors' Purse</button>
    </div>

    <!-- Summary bar -->
    <div class="cpb-summary-bar">
      <div class="cpb-summary-item">
        <span class="cpb-summary-num" id="statTotal">{fmt(totalActiveBalance)}</span>
        <span class="cpb-summary-label">active balance</span>
      </div>
      <div class="cpb-summary-item">
        <span class="cpb-summary-num" id="statNonZero">{nonZeroActive.length}</span>
        <span class="cpb-summary-label">non-zero cards</span>
      </div>
      <div class="cpb-summary-item">
        <span class="cpb-summary-num" id="statTotal2">{allRows.length}</span>
        <span class="cpb-summary-label">total cards</span>
      </div>
      {deadRows.length > 0 && (
        <div class="cpb-summary-item">
          <span class="cpb-summary-num cpb-negative" id="statDead">{fmt(totalDeadBalance)}</span>
          <span class="cpb-summary-label">dead card balance</span>
        </div>
      )}
      {lastFetched && (
        <div class="cpb-summary-item cpb-summary-meta">
          <span class="cpb-summary-label">last synced</span>
          <span class="cpb-summary-date" id="statLastFetched">{fmtDate(lastFetched)}</span>
        </div>
      )}
    </div>

    <!-- Toolbar: search + sort + filter -->
    <div class="cpb-toolbar">
      <div class="cpb-search-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" class="cpb-search-icon">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" id="searchInput" class="cpb-search" placeholder="Search name or number…" autocomplete="off" />
        <button id="searchClear" class="cpb-search-clear" style="display:none;" title="Clear search">✕</button>
      </div>
      <label class="cpb-toggle-label">
        <input type="checkbox" id="showZeroToggle" />
        Show zero balance
      </label>
      <div class="cpb-sort-controls">
        <span class="cpb-sort-label">Sort:</span>
        <button class="cpb-sort-btn active" data-sort="name" id="sortName">Name ▲</button>
        <button class="cpb-sort-btn" data-sort="number" id="sortNumber">Number</button>
        <button class="cpb-sort-btn" data-sort="balance" id="sortBalance">Balance</button>
      </div>
    </div>

    <!-- Debug panel -->
    <div id="debugPanel" style="display:none;margin-bottom:1.25rem;">
      <div class="cpb-card">
        <div class="cpb-card-header">
          <h3>Debug</h3>
          <div style="display:flex;gap:0.5rem;align-items:center;">
            <select id="debugGroupSelect" class="cpb-select-sm">
              <option value="1">1 — MEMBERS</option>
              <option value="2">2 — SOCIAL MEMBER</option>
              <option value="3">3 — Dead Cards</option>
              <option value="4">4 — STAFF DISCOUNT</option>
            </select>
            <button id="debugFetchBtn" class="cpb-btn cpb-btn-ghost" style="padding:0.3rem 0.625rem;font-size:0.75rem;">Fetch</button>
            <button id="debugClose" class="cpb-btn cpb-btn-ghost" style="padding:0.3rem 0.625rem;font-size:0.75rem;">Close</button>
          </div>
        </div>
        <div style="padding:1rem 1.25rem;">
          <pre id="debugOutput" style="font-size:0.7rem;line-height:1.5;white-space:pre-wrap;word-break:break-all;max-height:500px;overflow-y:auto;background:#f8f8f8;border:1px solid #e8e8e8;border-radius:8px;padding:0.75rem;margin:0;"></pre>
        </div>
      </div>
    </div>

    <!-- Main active cards table -->
    <div class="cpb-card" id="mainCard">
      <div class="cpb-card-header">
        <h3>Active Cards</h3>
        <span class="cpb-badge" id="mainCount">—</span>
      </div>
      <div class="cpb-table-wrap">
        <table class="cpb-table" id="mainTable">
          <thead>
            <tr>
              <th class="col-num">#</th>
              <th class="col-name">Name</th>
              <th class="col-group">Group</th>
              <th class="col-bal text-right">Balance</th>
              <th class="col-member">Member Match</th>
            </tr>
          </thead>
          <tbody id="mainBody">
            <tr><td colspan="6" class="cpb-empty">No data — use "Sync from TouchOffice" to load.</td></tr>
          </tbody>
        </table>
      </div>
      <div id="mainPagination" class="cpb-pagination" style="display:none;">
        <button id="mainPrev" class="cpb-btn cpb-btn-ghost cpb-pag-btn">← Previous</button>
        <span id="mainPageInfo" class="cpb-pag-info"></span>
        <button id="mainNext" class="cpb-btn cpb-btn-ghost cpb-pag-btn">Next →</button>
      </div>
    </div>

    <!-- Unmatched zero balance section -->
    <div class="cpb-card" id="unmatchedCard" style="margin-top:1.25rem;">
      <div class="cpb-card-header">
        <h3>Needs Review — Unmatched Zero Balance</h3>
        <span class="cpb-badge cpb-badge-warn" id="unmatchedCount">—</span>
      </div>
      <p class="cpb-section-desc">
        Active cards with zero balance and no member match. Review these — they may need to be moved to Dead Cards in TouchOffice.
      </p>
      <div class="cpb-table-wrap">
        <table class="cpb-table" id="unmatchedTable">
          <thead>
            <tr>
              <th class="col-num">#</th>
              <th class="col-name">Name</th>
              <th class="col-group">Group</th>
              <th class="col-member">Member Match</th>
            </tr>
          </thead>
          <tbody id="unmatchedBody">
            <tr><td colspan="4" class="cpb-empty">Loading…</td></tr>
          </tbody>
        </table>
      </div>
      <div id="unmatchedPagination" class="cpb-pagination" style="display:none;">
        <button id="unmatchedPrev" class="cpb-btn cpb-btn-ghost cpb-pag-btn">← Previous</button>
        <span id="unmatchedPageInfo" class="cpb-pag-info"></span>
        <button id="unmatchedNext" class="cpb-btn cpb-btn-ghost cpb-pag-btn">Next →</button>
      </div>
    </div>

    <!-- Dead cards section (only shown if any have non-zero balance) -->
    <div class="cpb-card" id="deadCard" style="margin-top:1.25rem;display:none;">
      <div class="cpb-card-header">
        <h3>Dead Cards — Non-Zero Balance</h3>
        <span class="cpb-badge cpb-badge-err" id="deadCount">—</span>
      </div>
      <p class="cpb-section-desc">
        Cards marked as Dead in TouchOffice that still carry a balance. These need to be resolved.
      </p>
      <div class="cpb-table-wrap">
        <table class="cpb-table" id="deadTable">
          <thead>
            <tr>
              <th class="col-num">#</th>
              <th class="col-name">Name</th>
              <th class="col-bal text-right">Balance</th>
            </tr>
          </thead>
          <tbody id="deadBody">
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>

<style is:global>
  .cpb-page { max-width: 1060px; }

  .cpb-page-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;
  }
  .cpb-title { font-size: 1.375rem; font-weight: 700; color: #1a1a1a; margin: 0 0 0.2rem; }
  .cpb-sub   { font-size: 0.8125rem; color: #666; margin: 0; }
  .cpb-controls { display: flex; align-items: center; gap: 0.625rem; flex-wrap: wrap; }

  /* Sync status */
  .cpb-sync-status {
    display: flex; align-items: center; gap: 0.625rem;
    font-size: 0.8125rem; color: #666; margin-bottom: 0.75rem;
  }
  .cpb-spinner {
    width: 14px; height: 14px; border: 2px solid #ddd; border-top-color: #1e5631;
    border-radius: 50%; animation: cpb-spin 0.8s linear infinite; flex-shrink: 0;
  }
  @keyframes cpb-spin { to { transform: rotate(360deg); } }
  .cpb-sync-result {
    font-size: 0.8125rem; padding: 0.5rem 0.75rem; border-radius: 8px; margin-bottom: 0.75rem;
  }
  .cpb-sync-result.success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
  .cpb-sync-result.error   { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }

  /* Mismatch warning */
  .cpb-mismatch-banner {
    display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;
    background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px;
    padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.8125rem; color: #92400e;
  }

  /* Buttons */
  .cpb-btn {
    display: inline-flex; align-items: center; gap: 0.375rem;
    padding: 0.5rem 1rem; border-radius: 100px; font-size: 0.875rem; font-weight: 600;
    border: none; cursor: pointer; transition: background 0.15s;
  }
  .cpb-btn-primary { background: #1e5631; color: #fff; }
  .cpb-btn-primary:hover { background: #164424; }
  .cpb-btn-primary:disabled { background: #9ca3af; cursor: not-allowed; }
  .cpb-btn-outline { background: #fff; color: #1e5631; border: 1.5px solid #1e5631; }
  .cpb-btn-outline:hover { background: #f0fdf4; }
  .cpb-btn-ghost { background: none; color: #6b7280; border: 1px solid #d1d5db; }
  .cpb-btn-ghost:hover { background: #f9fafb; }
  .cpb-btn-sm { padding: 0.35rem 0.75rem; font-size: 0.8125rem; }

  /* Summary bar */
  .cpb-summary-bar {
    display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem;
    background: #fff; border-radius: 16px; padding: 1rem 1.25rem;
    margin-bottom: 1.25rem; box-shadow: 0 1px 4px rgba(0,0,0,0.07);
    border: 1px solid #e8e8e8;
  }
  .cpb-summary-item { display: flex; flex-direction: column; align-items: center; min-width: 80px; flex: 1; }
  .cpb-summary-num { font-size: 1.25rem; font-weight: 700; color: #1e5631; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .cpb-summary-label { font-size: 0.6875rem; color: #888; text-align: center; margin-top: 0.1rem; }
  .cpb-summary-meta { align-items: flex-start; }
  .cpb-summary-date { font-size: 0.8125rem; color: #555; margin-top: 0.1rem; }
  .cpb-negative { color: #b91c1c !important; }

  /* Toolbar */
  .cpb-toolbar {
    display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .cpb-search-wrap {
    position: relative; display: flex; align-items: center; flex: 1; min-width: 200px; max-width: 340px;
  }
  .cpb-search-icon { position: absolute; left: 0.75rem; color: #9ca3af; pointer-events: none; }
  .cpb-search {
    width: 100%; padding: 0.45rem 2.25rem 0.45rem 2.25rem;
    border: 1px solid #d1d5db; border-radius: 100px; font-size: 0.875rem;
    color: #1a1a1a; background: #fff;
  }
  .cpb-search:focus { outline: none; border-color: #1e5631; box-shadow: 0 0 0 3px rgba(30,86,49,0.1); }
  .cpb-search-clear {
    position: absolute; right: 0.625rem; background: none; border: none;
    color: #9ca3af; cursor: pointer; font-size: 0.875rem; padding: 0.15rem 0.25rem;
  }
  .cpb-search-clear:hover { color: #374151; }
  .cpb-toggle-label {
    display: flex; align-items: center; gap: 0.375rem;
    font-size: 0.8125rem; color: #555; cursor: pointer; white-space: nowrap;
  }
  .cpb-toggle-label input[type="checkbox"] { cursor: pointer; }
  .cpb-sort-controls { display: flex; align-items: center; gap: 0.375rem; flex-shrink: 0; }
  .cpb-sort-label { font-size: 0.8125rem; color: #888; }
  .cpb-sort-btn {
    padding: 0.3rem 0.75rem; border-radius: 100px; font-size: 0.8125rem; font-weight: 500;
    border: 1px solid #d1d5db; background: #fff; color: #555; cursor: pointer;
  }
  .cpb-sort-btn:hover { border-color: #1e5631; color: #1e5631; }
  .cpb-sort-btn.active { background: #1e5631; color: #fff; border-color: #1e5631; }

  .cpb-select-sm {
    padding: 0.3rem 0.5rem; border: 1px solid #d1d5db; border-radius: 7px;
    font-size: 0.8125rem; background: #fff; color: #1a1a1a;
  }

  /* Card */
  .cpb-card {
    background: #fff; border-radius: 16px; border: 1px solid #e8e8e8;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06); overflow: hidden;
  }
  .cpb-card-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.875rem 1.25rem; border-bottom: 1px solid #f0f0f0; background: #fafafa;
  }
  .cpb-card-header h3 { font-size: 0.9375rem; font-weight: 600; color: #1a1a1a; margin: 0; }
  .cpb-badge {
    font-size: 0.75rem; padding: 0.2rem 0.625rem;
    background: #e8f5e9; color: #1e5631; border-radius: 20px; font-weight: 500;
  }
  .cpb-badge-warn { background: #fffbeb; color: #92400e; }
  .cpb-badge-err  { background: #fef2f2; color: #b91c1c; }
  .cpb-section-desc {
    font-size: 0.8125rem; color: #6b7280; padding: 0.625rem 1.25rem 0;
    margin: 0; border-bottom: 1px solid #f0f0f0; padding-bottom: 0.625rem;
  }

  /* Table */
  .cpb-table-wrap { overflow-x: auto; }
  .cpb-table {
    width: 100%; border-collapse: collapse;
    font-variant-numeric: tabular-nums; font-size: 0.875rem;
  }
  .cpb-table th {
    padding: 0.5rem 0.875rem; text-align: left;
    background: #fafafa; font-weight: 600; color: #666;
    font-size: 0.75rem; letter-spacing: 0.4px; text-transform: uppercase;
    border-bottom: 2px solid #e8e8e8; white-space: nowrap;
  }
  .cpb-table th.text-right { text-align: right; }
  .cpb-table td {
    padding: 0.5rem 0.875rem; border-bottom: 1px solid #f5f5f5;
    color: #333; vertical-align: middle;
  }
  .cpb-table td.text-right { text-align: right; }
  .cpb-table tr:hover td { background: #fafafa; }

  .col-num    { width: 60px; }
  .col-name   { min-width: 160px; }
  .col-group  { white-space: nowrap; }
  .col-bal    { white-space: nowrap; font-weight: 500; }

  .col-member { min-width: 200px; }

  .cpb-empty { text-align: center; color: #888; padding: 2rem; font-size: 0.875rem; }

  /* Group pill */
  .cpb-group-pill {
    display: inline-block; padding: 0.15rem 0.5rem; border-radius: 20px;
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.3px; white-space: nowrap;
  }
  .pill-members  { background: #e8f5e9; color: #166534; }
  .pill-social   { background: #eff6ff; color: #1d4ed8; }
  .pill-staff    { background: #faf5ff; color: #7c3aed; }
  .pill-dead     { background: #fef2f2; color: #b91c1c; }

  /* Balance colour */
  .bal-positive { color: #166534; font-weight: 600; }
  .bal-zero     { color: #9ca3af; }

  /* Member select */
  .cpb-member-select {
    padding: 0.35rem 0.5rem; border: 1px solid #d1d5db; border-radius: 7px;
    font-size: 0.8125rem; color: #1a1a1a; background: #fff;
    min-width: 180px; max-width: 260px; width: 100%;
  }
  .cpb-member-select:focus { outline: none; border-color: #1e5631; box-shadow: 0 0 0 3px rgba(30,86,49,0.1); }
  .cpb-match-saved  { font-size: 0.7rem; color: #166534; margin-left: 0.375rem; }
  .cpb-match-err    { font-size: 0.7rem; color: #b91c1c; margin-left: 0.375rem; }

  /* Pagination */
  .cpb-pagination {
    display: flex; align-items: center; justify-content: center;
    gap: 1rem; padding: 0.75rem 1.25rem; border-top: 1px solid #f0f0f0;
  }
  .cpb-pag-btn { border-radius: 8px; padding: 0.4rem 0.875rem; font-size: 0.8125rem; }
  .cpb-pag-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .cpb-pag-info { font-size: 0.8125rem; color: #555; min-width: 130px; text-align: center; }

  /* Seniors row highlight */
  .cpb-seniors-row td { background: #f0fdf4 !important; }
  .cpb-seniors-row td:first-child::before {
    content: '★ '; color: #1e5631; font-size: 0.7rem;
  }
</style>

<script is:inline define:vars={{ rowsData: allRows, membersData: members, seniorsPurseBalanceJson: seniorsPurseBalance }}>
  const ALL_MEMBERS = membersData;
  const PAGE_SIZE = 40;

  // ── State ────────────────────────────────────────────────────────────────────
  let allRows       = rowsData;
  let sortKey       = 'name';       // 'name' | 'number' | 'balance'
  let sortDir       = 1;            // 1 = asc, -1 = desc
  let searchQuery   = '';
  let showZero      = false;
  let mainPage      = 1;
  let unmatchedPage = 1;

  // Derived display subsets (recomputed on each render)
  let mainRows      = [];
  let unmatchedRows = [];
  let deadRows      = [];

  // ── DOM refs ─────────────────────────────────────────────────────────────────
  const syncBtn      = document.getElementById('syncBtn');
  const syncLabel    = document.getElementById('syncLabel');
  const syncStatus   = document.getElementById('syncStatus');
  const syncMessage  = document.getElementById('syncMessage');
  const syncResult   = document.getElementById('syncResult');
  const searchInput  = document.getElementById('searchInput');
  const searchClear  = document.getElementById('searchClear');
  const showZeroChk  = document.getElementById('showZeroToggle');
  const mainBody     = document.getElementById('mainBody');
  const unmatchedBody = document.getElementById('unmatchedBody');
  const deadBody     = document.getElementById('deadBody');
  const mainCount    = document.getElementById('mainCount');
  const unmatchedCount = document.getElementById('unmatchedCount');
  const deadCount    = document.getElementById('deadCount');
  const deadCard     = document.getElementById('deadCard');

  // ── Helpers ──────────────────────────────────────────────────────────────────
  function fmt(n) {
    return new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' }).format(n);
  }

  function escHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function groupPill(group) {
    const cls = group === 'MEMBERS' ? 'pill-members'
      : group === 'SOCIAL MEMBER'   ? 'pill-social'
      : group === 'STAFF DISCOUNT'  ? 'pill-staff'
      : 'pill-dead';
    return `<span class="cpb-group-pill ${cls}">${escHtml(group)}</span>`;
  }

  function balClass(bal) {
    return bal === 0 ? 'bal-zero' : 'bal-positive';
  }

  function buildMemberOptions(selectedId) {
    let opts = `<option value="">— No match —</option>`;
    for (const m of ALL_MEMBERS) {
      const sel = m.id === selectedId ? ' selected' : '';
      opts += `<option value="${m.id}"${sel}>${escHtml(m.surname)}, ${escHtml(m.first_name)}</option>`;
    }
    return opts;
  }

  // ── Sorting & filtering ──────────────────────────────────────────────────────
  function sortRows(rows) {
    return [...rows].sort((a, b) => {
      let cmp = 0;
      if (sortKey === 'number') {
        cmp = a.customer_number - b.customer_number;
      } else if (sortKey === 'balance') {
        cmp = b.account_balance - a.account_balance; // always desc by default
      } else {
        // name: last then first
        cmp = (a.last_name || '').localeCompare(b.last_name || '')
           || (a.first_name || '').localeCompare(b.first_name || '');
      }
      return cmp * sortDir;
    });
  }

  function matchesSearch(row) {
    if (!searchQuery) return true;
    const q = searchQuery.toLowerCase();
    return String(row.customer_number).includes(q)
      || (row.first_name || '').toLowerCase().includes(q)
      || (row.last_name  || '').toLowerCase().includes(q)
      || (row.member_name || '').toLowerCase().includes(q);
  }

  function computeSubsets() {
    const q = searchQuery.toLowerCase();
    const activeGroups = ['MEMBERS', 'SOCIAL MEMBER', 'STAFF DISCOUNT'];

    // Main: active, non-zero (unless showZero), matches search
    const mainFiltered = allRows.filter(r =>
      activeGroups.includes(r.customer_group)
      && (showZero || r.account_balance !== 0)
      && matchesSearch(r)
    );
    mainRows = sortRows(mainFiltered);

    // Unmatched zero: active, zero balance, no member_id, matches search
    const unmatchedFiltered = allRows.filter(r =>
      activeGroups.includes(r.customer_group)
      && r.account_balance === 0
      && !r.member_id
      && matchesSearch(r)
    );
    unmatchedRows = sortRows(unmatchedFiltered);

    // Dead: dead cards group, non-zero only, matches search
    const deadFiltered = allRows.filter(r =>
      r.customer_group === 'Dead Cards'
      && r.account_balance !== 0
      && matchesSearch(r)
    );
    deadRows = sortRows(deadFiltered);
  }

  // ── Render main table ────────────────────────────────────────────────────────
  function renderMain() {
    const total = mainRows.length;
    const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (mainPage > totalPages) mainPage = totalPages;

    mainCount.textContent = total + ' card' + (total !== 1 ? 's' : '');

    const pagEl    = document.getElementById('mainPagination');
    const pageInfo = document.getElementById('mainPageInfo');
    const prevBtn  = document.getElementById('mainPrev');
    const nextBtn  = document.getElementById('mainNext');

    if (!total) {
      mainBody.innerHTML = `<tr><td colspan="6" class="cpb-empty">No matching cards.</td></tr>`;
      pagEl.style.display = 'none';
      return;
    }

    const start = (mainPage - 1) * PAGE_SIZE;
    const end   = Math.min(start + PAGE_SIZE, total);
    const page  = mainRows.slice(start, end);

    mainBody.innerHTML = page.map(row => {
      const isSeniors = row.customer_number === 1035;
      const rowCls = isSeniors ? ' class="cpb-seniors-row"' : '';
      const balCls = balClass(row.account_balance);
      return `
        <tr${rowCls} data-custnum="${row.customer_number}">
          <td class="col-num">${row.customer_number}</td>
          <td class="col-name">${escHtml(row.last_name)}, ${escHtml(row.first_name)}</td>
          <td class="col-group">${groupPill(row.customer_group)}</td>
          <td class="col-bal text-right ${balCls}">${fmt(row.account_balance)}</td>
          <td class="col-member">
            <span style="display:flex;align-items:center;gap:0.25rem;">
              <select class="cpb-member-select" data-custnum="${row.customer_number}" data-auto="${row.auto_matched ? '1' : '0'}">
                ${buildMemberOptions(row.member_id)}
              </select>
              <span class="cpb-match-saved" id="ms-${row.customer_number}"></span>
            </span>
          </td>
        </tr>`;
    }).join('');

    wireSelects(mainBody);

    if (totalPages > 1) {
      pagEl.style.display = 'flex';
      pageInfo.textContent = `${start + 1}–${end} of ${total}`;
      prevBtn.disabled = mainPage <= 1;
      nextBtn.disabled = mainPage >= totalPages;
    } else {
      pagEl.style.display = 'none';
    }
  }

  // ── Render unmatched table ───────────────────────────────────────────────────
  function renderUnmatched() {
    const total = unmatchedRows.length;
    const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (unmatchedPage > totalPages) unmatchedPage = totalPages;

    unmatchedCount.textContent = total + ' card' + (total !== 1 ? 's' : '');

    const pagEl    = document.getElementById('unmatchedPagination');
    const pageInfo = document.getElementById('unmatchedPageInfo');
    const prevBtn  = document.getElementById('unmatchedPrev');
    const nextBtn  = document.getElementById('unmatchedNext');

    if (!total) {
      unmatchedBody.innerHTML = `<tr><td colspan="4" class="cpb-empty">None — all active zero-balance cards are matched.</td></tr>`;
      pagEl.style.display = 'none';
      return;
    }

    const start = (unmatchedPage - 1) * PAGE_SIZE;
    const end   = Math.min(start + PAGE_SIZE, total);
    const page  = unmatchedRows.slice(start, end);

    unmatchedBody.innerHTML = page.map(row => `
      <tr data-custnum="${row.customer_number}">
        <td class="col-num">${row.customer_number}</td>
        <td class="col-name">${escHtml(row.last_name)}, ${escHtml(row.first_name)}</td>
        <td class="col-group">${groupPill(row.customer_group)}</td>
        <td class="col-member">
          <span style="display:flex;align-items:center;gap:0.25rem;">
            <select class="cpb-member-select" data-custnum="${row.customer_number}" data-auto="0">
              ${buildMemberOptions(row.member_id)}
            </select>
            <span class="cpb-match-saved" id="ms-${row.customer_number}"></span>
          </span>
        </td>
      </tr>`
    ).join('');

    wireSelects(unmatchedBody);

    if (totalPages > 1) {
      pagEl.style.display = 'flex';
      pageInfo.textContent = `${start + 1}–${end} of ${total}`;
      prevBtn.disabled = unmatchedPage <= 1;
      nextBtn.disabled = unmatchedPage >= totalPages;
    } else {
      pagEl.style.display = 'none';
    }
  }

  // ── Render dead cards table ──────────────────────────────────────────────────
  function renderDead() {
    if (!deadRows.length) {
      deadCard.style.display = 'none';
      return;
    }
    deadCard.style.display = 'block';
    deadCount.textContent = deadRows.length + ' card' + (deadRows.length !== 1 ? 's' : '');

    deadBody.innerHTML = deadRows.map(row => {
      const balCls = balClass(row.account_balance);
      return `
        <tr>
          <td class="col-num">${row.customer_number}</td>
          <td class="col-name">${escHtml(row.last_name)}, ${escHtml(row.first_name)}</td>
          <td class="col-bal text-right ${balCls}">${fmt(row.account_balance)}</td>
        </tr>`;
    }).join('');
  }

  function renderAll() {
    computeSubsets();
    renderMain();
    renderUnmatched();
    renderDead();
  }

  // ── Wire member-select change handlers ───────────────────────────────────────
  function wireSelects(container) {
    container.querySelectorAll('.cpb-member-select').forEach(sel => {
      sel.addEventListener('change', () => saveMatch(sel));
    });
  }

  async function saveMatch(sel) {
    const custNum  = parseInt(sel.dataset.custnum);
    const memberId = sel.value ? parseInt(sel.value) : null;
    const fb       = document.getElementById('ms-' + custNum);

    if (fb) { fb.className = 'cpb-match-saved'; fb.textContent = 'Saving…'; }

    try {
      const res = await fetch('/api/customer-purse-balances', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'save-match', customerNumber: custNum, memberId }),
      });
      const data = await res.json();
      if (data.ok) {
        // Update the in-memory row so re-renders reflect the change
        const row = allRows.find(r => r.customer_number === custNum);
        if (row) {
          row.member_id   = memberId;
          row.member_name = data.memberName ?? null;
          row.auto_matched = 0;
        }
        if (fb) {
          fb.className = 'cpb-match-saved';
          fb.textContent = '✓';
          setTimeout(() => { if (fb) fb.textContent = ''; }, 2500);
        }
        // Re-render both tables in case this moves a row between sections
        computeSubsets();
        renderMain();
        renderUnmatched();
      } else {
        if (fb) { fb.className = 'cpb-match-err'; fb.textContent = 'Error'; }
      }
    } catch {
      if (fb) { fb.className = 'cpb-match-err'; fb.textContent = 'Network error'; }
    }
  }

  // ── Sync ─────────────────────────────────────────────────────────────────────
  syncBtn.addEventListener('click', async () => {
    syncBtn.disabled = true;
    syncLabel.textContent = 'Syncing…';
    syncStatus.style.display = 'flex';
    syncResult.style.display = 'none';
    syncMessage.textContent = 'Fetching all customer groups from TouchOffice…';

    try {
      const res = await fetch('/api/customer-purse-balances', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'sync' }),
      });
      const data = await res.json();
      syncStatus.style.display = 'none';

      if (data.error) {
        showResult('error', 'Error: ' + data.error);
      } else {
        const msg = `Sync complete — ${data.totalAdded} added, ${data.totalUpdated} updated`
          + (data.autoMatched > 0 ? `, ${data.autoMatched} auto-matched.` : '.');
        showResult('success', msg);

        // Update seniors mismatch banner
        updateSeniorsMismatch(data.seniorsCardBalance, data.seniorsPurseBalance, data.seniorsMismatch);

        // Reload table from API
        await loadRows();
      }
    } catch {
      syncStatus.style.display = 'none';
      showResult('error', 'Network error — could not reach TouchOffice.');
    } finally {
      syncBtn.disabled = false;
      syncLabel.textContent = 'Sync from TouchOffice';
    }
  });

  async function loadRows() {
    try {
      const res = await fetch('/api/customer-purse-balances', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'list' }),
      });
      const data = await res.json();
      if (!data.error) {
        allRows = data.rows || [];
        renderAll();
        // Update summary stats
        const activeGroups = ['MEMBERS', 'SOCIAL MEMBER', 'STAFF DISCOUNT'];
        const active = allRows.filter(r => activeGroups.includes(r.customer_group));
        const nonZero = active.filter(r => r.account_balance !== 0);
        const total = active.reduce((s, r) => s + (r.account_balance || 0), 0);
        document.getElementById('statTotal').textContent  = fmt(total);
        document.getElementById('statNonZero').textContent = String(nonZero.length);
        document.getElementById('statTotal2').textContent  = String(allRows.length);
        updateSeniorsMismatch(
          allRows.find(r => r.customer_number === 1035)?.account_balance ?? null,
          data.seniorsPurseBalance,
          false // recompute
        );
      }
    } catch {}
  }

  // ── Seniors mismatch banner ───────────────────────────────────────────────────
  function updateSeniorsMismatch(cardBal, purseBal, mismatch) {
    const banner = document.getElementById('seniorsMismatchBanner');
    const text   = document.getElementById('mismatchText');
    if (!banner || !text) return;

    const hasMismatch = mismatch !== false
      ? mismatch
      : (cardBal !== null && purseBal !== null && Math.abs(cardBal - purseBal) > 0.01);

    if (hasMismatch) {
      text.textContent = `Seniors' Purse balance mismatch: TouchOffice card shows ${fmt(cardBal ?? 0)}, CRM shows ${fmt(purseBal ?? 0)}.`;
      banner.style.display = 'flex';
    } else {
      banner.style.display = 'none';
    }
  }

  document.getElementById('syncSeniorsBtn')?.addEventListener('click', async () => {
    const btn = document.getElementById('syncSeniorsBtn');
    btn.disabled = true;
    btn.textContent = 'Syncing…';
    try {
      const year = new Date().getFullYear();
      const res = await fetch('/api/seniors-purse', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'sync', year }),
      });
      const data = await res.json();
      if (data.error) {
        showResult('error', 'Seniors purse sync error: ' + data.error);
      } else {
        showResult('success', `Seniors' Purse synced — ${data.added ?? 0} new transactions.`);
        document.getElementById('seniorsMismatchBanner').style.display = 'none';
      }
    } catch {
      showResult('error', 'Network error syncing Seniors\' Purse.');
    } finally {
      btn.disabled = false;
      btn.textContent = "Sync Seniors' Purse";
    }
  });

  // ── Search ───────────────────────────────────────────────────────────────────
  let searchTimer;
  searchInput.addEventListener('input', () => {
    searchQuery = searchInput.value.trim();
    searchClear.style.display = searchQuery ? 'block' : 'none';
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      mainPage = 1; unmatchedPage = 1;
      renderAll();
    }, 180);
  });
  searchClear.addEventListener('click', () => {
    searchInput.value = '';
    searchQuery = '';
    searchClear.style.display = 'none';
    mainPage = 1; unmatchedPage = 1;
    renderAll();
  });

  // ── Show-zero toggle ─────────────────────────────────────────────────────────
  showZeroChk.addEventListener('change', () => {
    showZero = showZeroChk.checked;
    mainPage = 1;
    renderAll();
  });

  // ── Sort buttons ─────────────────────────────────────────────────────────────
  document.querySelectorAll('.cpb-sort-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.sort;
      if (sortKey === key) {
        sortDir = -sortDir;
      } else {
        sortKey = key;
        sortDir = key === 'balance' ? -1 : 1;
      }
      document.querySelectorAll('.cpb-sort-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const arrow = sortDir === 1 ? ' ▲' : ' ▼';
      btn.textContent = (key === 'name' ? 'Name' : key === 'number' ? 'Number' : 'Balance') + arrow;
      mainPage = 1; unmatchedPage = 1;
      renderAll();
    });
  });

  // ── Pagination ───────────────────────────────────────────────────────────────
  document.getElementById('mainPrev').addEventListener('click', () => { mainPage--; renderMain(); });
  document.getElementById('mainNext').addEventListener('click', () => { mainPage++; renderMain(); });
  document.getElementById('unmatchedPrev').addEventListener('click', () => { unmatchedPage--; renderUnmatched(); });
  document.getElementById('unmatchedNext').addEventListener('click', () => { unmatchedPage++; renderUnmatched(); });

  // ── Debug panel ──────────────────────────────────────────────────────────────
  document.getElementById('debugBtn').addEventListener('click', () => {
    const panel = document.getElementById('debugPanel');
    panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
  });
  document.getElementById('debugClose').addEventListener('click', () => {
    document.getElementById('debugPanel').style.display = 'none';
  });
  document.getElementById('debugFetchBtn').addEventListener('click', async () => {
    const groupId = document.getElementById('debugGroupSelect').value;
    const btn = document.getElementById('debugFetchBtn');
    btn.disabled = true; btn.textContent = 'Fetching…';
    try {
      const res = await fetch('/api/customer-purse-balances', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'debug', groupId }),
      });
      const data = await res.json();
      document.getElementById('debugOutput').textContent = JSON.stringify(data, null, 2);
    } catch (e) {
      document.getElementById('debugOutput').textContent = 'Fetch failed: ' + e;
    } finally {
      btn.disabled = false; btn.textContent = 'Fetch';
    }
  });

  // ── Utility ──────────────────────────────────────────────────────────────────
  function showResult(type, msg) {
    syncResult.className = 'cpb-sync-result ' + type;
    syncResult.textContent = msg;
    syncResult.style.display = 'block';
    setTimeout(() => { syncResult.style.display = 'none'; }, 8000);
  }

  // ── Initial render from SSR data ─────────────────────────────────────────────
  renderAll();
</script>

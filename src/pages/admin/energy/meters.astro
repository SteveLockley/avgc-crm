---
import EnergyLayout from '../../../layouts/EnergyLayout.astro';

const db = Astro.locals.runtime.env.DB;

const fmtDate = (iso: string | null | undefined) => {
  if (!iso) return '—'
  const [y, m, d] = iso.split('-')
  return `${d}/${m}/${y}`
}
const meters = (await db.prepare('SELECT * FROM energy_meters ORDER BY name').all()).results as any[];

const loggerCircuits = (await db.prepare(`
  SELECT * FROM energy_logger_circuits
  ORDER BY meter_name,
    CASE WHEN circuit = 'main' THEN 0 ELSE 1 END,
    circuit
`).all()).results as any[];

const circuitsByMeter: Record<string, any[]> = {}
for (const c of loggerCircuits) {
  (circuitsByMeter[c.meter_name] ??= []).push(c)
}
const loggerMeters = Object.keys(circuitsByMeter).sort()

const lastReadings = (await db.prepare(`
  SELECT b.mpan, b.closing_read_date, b.closing_read, b.register_id
  FROM energy_bill_lines b
  INNER JOIN (
    SELECT mpan, MAX(closing_read_date) AS max_date
    FROM energy_bill_lines GROUP BY mpan
  ) latest ON b.mpan = latest.mpan AND b.closing_read_date = latest.max_date
  GROUP BY b.mpan
`).all()).results as any[];
const lastReadMap = Object.fromEntries(lastReadings.map((r: any) => [r.mpan, r]));
---

<EnergyLayout title="Meters" tab="meters">

  {meters.length === 0 ? (
    <div class="empty-state-card">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      <h3>No meters yet</h3>
      <p>Upload a CSV file to register meters automatically.</p>
    </div>
  ) : (
    <div class="meters-grid" id="meters-list">
      {meters.map((m: any) => (
        <div class="m3-card" data-id={m.id}>
          <div class="card-header">
            <div class="card-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              <span class="meter-name" title={`MPAN: ${m.mpan}`}>{m.name}</span>
              {m.has_smart === 1 && <span class="card-badge">Smart meter</span>}
            </div>
            <button class="action-btn secondary edit-btn" data-id={m.id} data-name={m.name} data-location={m.location ?? ''}>
              Rename
            </button>
          </div>
          <div class="card-content">
            <div class="meter-details">
              <div class="detail-item">
                <span class="detail-label">MPAN</span>
                <span class="detail-value mono">{m.mpan}</span>
              </div>
              {m.serial && (
                <div class="detail-item">
                  <span class="detail-label">Serial</span>
                  <span class="detail-value mono">{m.serial}</span>
                </div>
              )}
              <div class="detail-item">
                <span class="detail-label">Address</span>
                <span class="detail-value">{m.address || '—'}</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Location</span>
                <span class="detail-value meter-location">{m.location || '—'}</span>
              </div>
              {lastReadMap[m.mpan] && (
                <>
                  <div class="detail-item">
                    <span class="detail-label">Last reading date</span>
                    <span class="detail-value">{fmtDate(lastReadMap[m.mpan].closing_read_date)}</span>
                  </div>
                  <div class="detail-item">
                    <span class="detail-label">Last reading (kWh)</span>
                    <span class="detail-value mono">{lastReadMap[m.mpan].closing_read?.toLocaleString()}</span>
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  )}


{loggerMeters.length > 0 && (
  <div style="margin-top:2rem;">
    <h2 class="section-heading">Logger circuits</h2>
    <div class="meters-grid">
      {loggerMeters.map(meterName => (
        <div class="m3-card">
          <div class="card-header">
            <div class="card-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
              <span>{meterName.charAt(0).toUpperCase() + meterName.slice(1)} meter</span>
            </div>
          </div>
          <div class="card-content">
            <div class="circuit-list">
              {circuitsByMeter[meterName].map((c: any) => (
                <div class="circuit-row" data-id={c.id}>
                  <span class="circuit-key mono">{c.circuit}</span>
                  <span class="circuit-label">{c.label}</span>
                  <button class="action-btn secondary rename-circuit-btn"
                    data-id={c.id} data-label={c.label} data-circuit={c.circuit}>
                    Rename
                  </button>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
)}

<!-- Rename circuit modal -->
<div class="m3-dialog-overlay" id="circuitEditOverlay">
  <div class="m3-dialog">
    <div class="m3-dialog-title">Rename circuit</div>
    <div class="m3-dialog-content" style="text-align:left;">
      <input type="hidden" id="circuitEditId" />
      <div style="margin-bottom:0.75rem;">
        <span style="font-size:0.8125rem;color:#888;">Circuit: </span>
        <span id="circuitEditKey" class="mono" style="font-size:0.8125rem;color:#555;"></span>
      </div>
      <div class="form-group">
        <label class="form-label">Display name</label>
        <input id="circuitEditLabel" type="text" class="form-input" />
      </div>
    </div>
    <div class="m3-dialog-actions">
      <button id="cancelCircuitEdit" class="m3-btn m3-btn-text">Cancel</button>
      <button id="saveCircuitEdit" class="m3-btn m3-btn-filled">Save</button>
    </div>
  </div>
</div>

<!-- Rename meter modal -->
<div class="m3-dialog-overlay" id="editOverlay">
  <div class="m3-dialog">
    <div class="m3-dialog-title">Rename meter</div>
    <div class="m3-dialog-content" style="text-align:left;">
      <input type="hidden" id="editId" />
      <div class="form-group">
        <label class="form-label">Name</label>
        <input id="editName" type="text" class="form-input" />
      </div>
      <div class="form-group">
        <label class="form-label">Location / note</label>
        <input id="editLocation" type="text" class="form-input" placeholder="e.g. Greenkeepers Building" />
      </div>
    </div>
    <div class="m3-dialog-actions">
      <button id="cancelEdit" class="m3-btn m3-btn-text">Cancel</button>
      <button id="saveEdit" class="m3-btn m3-btn-filled">Save</button>
    </div>
  </div>
</div>

<style>
  .page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .header-content h1 { margin: 0; font-size: 1.75rem; font-weight: 600; color: #1a1a1a; }
  .subtitle { margin: 0.25rem 0 0; color: #666; font-size: 0.95rem; }

  .meters-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1rem; }

  .m3-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); border: 1px solid #e8e8e8; overflow: hidden; }
  .card-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; border-bottom: 1px solid #f0f0f0; background: #fafafa; gap: 0.5rem; }
  .card-title { display: flex; align-items: center; gap: 0.625rem; font-weight: 600; color: #1a1a1a; font-size: 1rem; flex: 1; min-width: 0; }
  .card-title svg { width: 20px; height: 20px; color: #1e5631; flex-shrink: 0; }
  .card-title .meter-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .card-badge { font-size: 0.75rem; padding: 0.25rem 0.625rem; background: #e8f5e9; color: #1e5631; border-radius: 20px; font-weight: 500; flex-shrink: 0; }
  .card-content { padding: 1.25rem; }

  .meter-details { display: grid; grid-template-columns: 1fr 1fr; gap: 0.875rem; }
  .detail-item { display: flex; flex-direction: column; gap: 3px; }
  .detail-label { font-size: 0.75rem; font-weight: 600; color: #999; text-transform: uppercase; letter-spacing: 0.4px; }
  .detail-value { font-size: 0.875rem; color: #333; }
  .detail-value.mono { font-family: monospace; font-size: 0.8125rem; }

  .action-btn { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; border-radius: 10px; font-size: 0.875rem; font-weight: 500; text-decoration: none; cursor: pointer; border: none; transition: all 0.2s ease; white-space: nowrap; }
  .action-btn svg { width: 16px; height: 16px; flex-shrink: 0; }
  .action-btn.primary { background: linear-gradient(135deg, #1e5631 0%, #2d7a45 100%); color: #fff; }
  .action-btn.primary:hover { background: linear-gradient(135deg, #164024 0%, #246339 100%); }
  .action-btn.secondary { background: #f0f0f0; color: #333; font-size: 0.8125rem; padding: 0.375rem 0.75rem; }
  .action-btn.secondary:hover { background: #e4e4e4; }

  .empty-state-card { background: #fff; border-radius: 16px; border: 1px solid #e8e8e8; box-shadow: 0 2px 8px rgba(0,0,0,0.06); display: flex; flex-direction: column; align-items: center; text-align: center; padding: 4rem 2rem; gap: 0.75rem; }
  .empty-state-card svg { width: 48px; height: 48px; color: #ccc; }
  .empty-state-card h3 { font-size: 1.125rem; font-weight: 600; color: #333; margin: 0; }
  .empty-state-card p { color: #666; font-size: 0.9rem; margin: 0; }

  .section-heading { font-size: 1.125rem; font-weight: 600; color: #1a1a1a; margin: 0 0 1rem; }

  .circuit-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .circuit-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem; background: #fafafa; border-radius: 8px; border: 1px solid #f0f0f0; }
  .circuit-key { font-size: 0.8rem; color: #888; min-width: 72px; flex-shrink: 0; }
  .circuit-label { flex: 1; font-size: 0.9rem; color: #1a1a1a; font-weight: 500; }

  .form-group { display: flex; flex-direction: column; gap: 0.375rem; }
  .form-label { font-size: 0.8125rem; font-weight: 600; color: #555; }
  .form-input { padding: 0.625rem 0.875rem; border: 1.5px solid #d8d8d8; border-radius: 10px; font-size: 0.9rem; color: #1a1a1a; background: #fff; transition: border-color 0.15s; }
  .form-input:focus { outline: none; border-color: #1e5631; }

  @media (max-width: 600px) {
    .meters-grid { grid-template-columns: 1fr; }
    .page-header { flex-direction: column; }
    .meter-details { grid-template-columns: 1fr; }
  }
</style>

<script>
  const overlay  = document.getElementById('editOverlay')!;
  const editId   = document.getElementById('editId') as HTMLInputElement;
  const editName = document.getElementById('editName') as HTMLInputElement;
  const editLoc  = document.getElementById('editLocation') as HTMLInputElement;

  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const b = btn as HTMLElement;
      editId.value   = b.dataset.id!;
      editName.value = b.dataset.name!;
      editLoc.value  = b.dataset.location!;
      overlay.classList.add('open');
    });
  });

  document.getElementById('cancelEdit')!.addEventListener('click', () => overlay.classList.remove('open'));
  overlay.addEventListener('click', e => { if (e.target === overlay) overlay.classList.remove('open'); });

  document.getElementById('saveEdit')!.addEventListener('click', async () => {
    const id = parseInt(editId.value);
    await fetch('/api/energy/meters', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, name: editName.value, location: editLoc.value }),
    });
    const card = document.querySelector(`[data-id="${id}"]`);
    if (card) {
      card.querySelector('.meter-name')!.textContent = editName.value;
      card.querySelector('.meter-location')!.textContent = editLoc.value || '—';
      const btn = card.querySelector('.edit-btn') as HTMLElement;
      btn.dataset.name = editName.value;
      btn.dataset.location = editLoc.value;
    }
    overlay.classList.remove('open');
  });

  // Circuit rename
  const circuitOverlay    = document.getElementById('circuitEditOverlay')!;
  const circuitEditId     = document.getElementById('circuitEditId') as HTMLInputElement;
  const circuitEditKey    = document.getElementById('circuitEditKey')!;
  const circuitEditLabel  = document.getElementById('circuitEditLabel') as HTMLInputElement;

  document.querySelectorAll('.rename-circuit-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const b = btn as HTMLElement;
      circuitEditId.value    = b.dataset.id!;
      circuitEditKey.textContent = b.dataset.circuit!;
      circuitEditLabel.value = b.dataset.label!;
      circuitOverlay.classList.add('open');
    });
  });

  document.getElementById('cancelCircuitEdit')!.addEventListener('click', () => circuitOverlay.classList.remove('open'));
  circuitOverlay.addEventListener('click', e => { if (e.target === circuitOverlay) circuitOverlay.classList.remove('open'); });

  document.getElementById('saveCircuitEdit')!.addEventListener('click', async () => {
    const id    = parseInt(circuitEditId.value);
    const label = circuitEditLabel.value.trim();
    if (!label) return;
    await fetch('/api/energy/circuits', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, label }),
    });
    const row = document.querySelector(`.circuit-row[data-id="${id}"]`);
    if (row) {
      row.querySelector('.circuit-label')!.textContent = label;
      (row.querySelector('.rename-circuit-btn') as HTMLElement).dataset.label = label;
    }
    circuitOverlay.classList.remove('open');
  });
</script>

</EnergyLayout>

---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatDate, formatCurrency, getFullName, getFullAddress, formatInvoicePeriod, type Invoice, type InvoiceItem, type Member } from '../../../lib/db';
import { generateInvoiceEmail } from '../../../lib/email-template';
import { calculateLineItems, loadFeeItems } from '../../../lib/generate-invoice';

const { id } = Astro.params;
const db = Astro.locals.runtime.env.DB;
const user = Astro.locals.user;

const invoice = await db.prepare(
  `SELECT * FROM invoices WHERE id = ?`
).bind(id).first<Invoice>();
if (!invoice) return Astro.redirect('/admin/invoices');

const member = await db.prepare(
  `SELECT * FROM members WHERE id = ?`
).bind(invoice.member_id).first<Member>();
if (!member) return Astro.redirect('/admin/invoices');

const settingsResult = await db.prepare(`SELECT * FROM invoice_settings`).all();
const settings: Record<string, string> = {};
(settingsResult.results || []).forEach((row: any) => { settings[row.setting_key] = row.setting_value; });

const paymentItemsResult = await db.prepare(
  `SELECT id, name, fee, category FROM payment_items WHERE active = 1 ORDER BY category, name`
).all();
const allPaymentItems = (paymentItemsResult.results || []) as { id: number; name: string; fee: number; category: string }[];
const feePaymentItems = allPaymentItems.filter(p => p.category === 'Fee');
const subPaymentItems = allPaymentItems.filter(p => p.category === 'Subscription');

let error = '';
let success = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  if (action === 'add_line_item') {
    const paymentItemId = formData.get('payment_item_id');
    const description = ((formData.get('description') as string) || '').trim();
    const unitPrice = parseFloat(formData.get('unit_price') as string);
    const quantity = parseInt(formData.get('quantity') as string) || 1;

    if (!description || isNaN(unitPrice) || unitPrice < 0) {
      error = 'Please provide a description and valid price';
    } else {
      const lineTotal = parseFloat((unitPrice * quantity).toFixed(2));
      const pid = paymentItemId ? parseInt(paymentItemId as string) : null;

      await db.prepare(
        `INSERT INTO invoice_items (invoice_id, payment_item_id, description, quantity, unit_price, line_total)
         VALUES (?, ?, ?, ?, ?, ?)`
      ).bind(id, pid || null, description, quantity, unitPrice, lineTotal).run();

      await db.prepare(
        `UPDATE invoices SET subtotal = subtotal + ?, total = total + ?, updated_at = datetime('now') WHERE id = ?`
      ).bind(lineTotal, lineTotal, id).run();

      await db.prepare(
        `UPDATE members SET account_balance = account_balance - ? WHERE id = ?`
      ).bind(lineTotal, invoice.member_id).run();

      success = `Added "${description}"`;
      await db.prepare(
        `INSERT INTO audit_log (user_email, action, entity_type, entity_id, details) VALUES (?, 'add_line_item', 'invoice', ?, ?)`
      ).bind(user?.email || 'system', id, JSON.stringify({ description, unitPrice, quantity })).run();
    }

  } else if (action === 'remove_line_item') {
    const itemId = parseInt(formData.get('item_id') as string);
    const item = await db.prepare(
      `SELECT id, line_total FROM invoice_items WHERE id = ? AND invoice_id = ?`
    ).bind(itemId, id).first<{ id: number; line_total: number }>();

    if (!item) {
      error = 'Line item not found';
    } else {
      await db.prepare(`DELETE FROM invoice_items WHERE id = ?`).bind(itemId).run();
      await db.prepare(
        `UPDATE invoices SET subtotal = subtotal - ?, total = total - ?, updated_at = datetime('now') WHERE id = ?`
      ).bind(item.line_total, item.line_total, id).run();
      await db.prepare(
        `UPDATE members SET account_balance = account_balance + ? WHERE id = ?`
      ).bind(item.line_total, invoice.member_id).run();
      success = 'Line item removed';
      await db.prepare(
        `INSERT INTO audit_log (user_email, action, entity_type, entity_id, details) VALUES (?, 'remove_line_item', 'invoice', ?, ?)`
      ).bind(user?.email || 'system', id, JSON.stringify({ itemId })).run();
    }

  } else if (action === 'link_family_member') {
    const familyMemberId = parseInt(formData.get('family_member_id') as string);
    const famMember = await db.prepare(
      `SELECT m.*,
              COALESCE(p1.fee, p2.fee, 0) as subscription_fee,
              COALESCE(p1.id, p2.id) as subscription_item_id
       FROM members m
       LEFT JOIN payment_items p1 ON p1.name = m.category AND p1.category = 'Subscription' AND p1.active = 1
       LEFT JOIN payment_items p2 ON p2.category = 'Subscription' AND p2.active = 1
         AND p2.name = TRIM(SUBSTR(m.category, 1, CASE WHEN INSTR(m.category, '(') > 0 THEN INSTR(m.category, '(') - 1 ELSE LENGTH(m.category) END))
       WHERE m.id = ?`
    ).bind(familyMemberId).first<any>();

    if (!famMember) {
      error = 'Member not found';
    } else {
      const feeItems = await loadFeeItems(db);
      const isSocial = famMember.category === 'Social';
      const lineItems = calculateLineItems(famMember, feeItems, isSocial);

      await db.prepare(`UPDATE members SET family_payer_id = ? WHERE id = ?`).bind(invoice.member_id, familyMemberId).run();

      let addedTotal = 0;
      for (const item of lineItems) {
        const desc = `${item.description} (${famMember.first_name} ${famMember.surname})`;
        await db.prepare(
          `INSERT INTO invoice_items (invoice_id, payment_item_id, description, quantity, unit_price, line_total, linked_member_id)
           VALUES (?, ?, ?, 1, ?, ?, ?)`
        ).bind(id, item.paymentItemId, desc, item.unitPrice, item.unitPrice, familyMemberId).run();
        addedTotal += item.unitPrice;
      }
      addedTotal = parseFloat(addedTotal.toFixed(2));

      await db.prepare(
        `UPDATE invoices SET subtotal = subtotal + ?, total = total + ?, updated_at = datetime('now') WHERE id = ?`
      ).bind(addedTotal, addedTotal, id).run();
      await db.prepare(
        `UPDATE members SET account_balance = account_balance - ? WHERE id = ?`
      ).bind(addedTotal, invoice.member_id).run();

      const existingFamInvoice = await db.prepare(
        `SELECT id, total FROM invoices WHERE member_id = ? AND period_start = ? AND period_end = ? AND status != 'cancelled' LIMIT 1`
      ).bind(familyMemberId, invoice.period_start, invoice.period_end).first<{ id: number; total: number }>();
      if (existingFamInvoice) {
        await db.prepare(`UPDATE invoices SET status = 'cancelled' WHERE id = ?`).bind(existingFamInvoice.id).run();
        await db.prepare(`UPDATE members SET account_balance = account_balance + ? WHERE id = ?`).bind(existingFamInvoice.total, familyMemberId).run();
      }

      success = `${famMember.first_name} ${famMember.surname} linked — ${lineItems.length} item(s) added`;
      await db.prepare(
        `INSERT INTO audit_log (user_email, action, entity_type, entity_id, details) VALUES (?, 'link_family_member', 'invoice', ?, ?)`
      ).bind(user?.email || 'system', id, JSON.stringify({ familyMemberId, name: `${famMember.first_name} ${famMember.surname}` })).run();
    }

  } else if (action === 'unlink_family_member') {
    const familyMemberId = parseInt(formData.get('family_member_id') as string);
    const famItems = await db.prepare(
      `SELECT id, line_total FROM invoice_items WHERE invoice_id = ? AND linked_member_id = ?`
    ).bind(id, familyMemberId).all();
    const removedTotal = parseFloat(((famItems.results || []) as { line_total: number }[]).reduce((s, i) => s + i.line_total, 0).toFixed(2));

    await db.prepare(`DELETE FROM invoice_items WHERE invoice_id = ? AND linked_member_id = ?`).bind(id, familyMemberId).run();
    await db.prepare(
      `UPDATE invoices SET subtotal = subtotal - ?, total = total - ?, updated_at = datetime('now') WHERE id = ?`
    ).bind(removedTotal, removedTotal, id).run();
    await db.prepare(`UPDATE members SET account_balance = account_balance + ? WHERE id = ?`).bind(removedTotal, invoice.member_id).run();
    await db.prepare(`UPDATE members SET family_payer_id = NULL WHERE id = ?`).bind(familyMemberId).run();

    const famName = await db.prepare(`SELECT first_name, surname FROM members WHERE id = ?`).bind(familyMemberId).first<{ first_name: string; surname: string }>();
    success = famName ? `${famName.first_name} ${famName.surname} unlinked` : 'Family member unlinked';
    await db.prepare(
      `INSERT INTO audit_log (user_email, action, entity_type, entity_id, details) VALUES (?, 'unlink_family_member', 'invoice', ?, ?)`
    ).bind(user?.email || 'system', id, JSON.stringify({ familyMemberId })).run();

  } else if (action === 'mark_paid') {
    const paymentMethod = formData.get('payment_method') as string || member.default_payment_method || 'BACS';
    await db.prepare(
      `UPDATE invoices SET status = 'paid', updated_at = datetime('now') WHERE id = ?`
    ).bind(id).run();
    await db.prepare(
      `UPDATE members SET account_balance = account_balance + ?, date_subscription_paid = date('now'), date_renewed = date('now'), date_expires = ?, default_payment_method = ? WHERE id = ?`
    ).bind(invoice.total, invoice.period_end, paymentMethod, invoice.member_id).run();

    const paymentResult = await db.prepare(
      `INSERT INTO payments (member_id, invoice_id, amount, payment_date, payment_method, payment_type, reference, notes, recorded_by)
       VALUES (?, ?, ?, date('now'), ?, 'subscription', ?, 'Recorded when invoice marked as paid', ?)`
    ).bind(member.id, id, invoice.total, paymentMethod, invoice.invoice_number, user?.email || 'system').run();

    const paymentId = paymentResult.meta?.last_row_id;
    if (paymentId) {
      const freshItems = await db.prepare(`SELECT * FROM invoice_items WHERE invoice_id = ?`).bind(id).all();
      for (const item of (freshItems.results || []) as InvoiceItem[]) {
        await db.prepare(
          `INSERT INTO payment_line_items (payment_id, invoice_item_id, payment_item_id, description, amount)
           VALUES (?, ?, ?, ?, ?)`
        ).bind(paymentId, item.id, item.payment_item_id, item.description, item.line_total).run();
      }
    }
    success = `Invoice marked as paid via ${paymentMethod}`;

  } else if (action === 'cancel') {
    const existingPayment = await db.prepare(
      `SELECT id, amount, payment_method FROM payments WHERE invoice_id = ? LIMIT 1`
    ).bind(id).first();

    await db.prepare(`UPDATE invoices SET status = 'cancelled', updated_at = datetime('now') WHERE id = ?`).bind(id).run();
    await db.prepare(`UPDATE members SET account_balance = account_balance + ? WHERE id = ?`).bind(invoice.total, invoice.member_id).run();

    if (existingPayment) {
      const refundResult = await db.prepare(
        `INSERT INTO payments (member_id, invoice_id, amount, payment_date, payment_method, payment_type, reference, notes, recorded_by)
         VALUES (?, ?, ?, date('now'), ?, 'subscription', ?, 'Refund — invoice cancelled', ?)`
      ).bind(invoice.member_id, id, -(existingPayment.amount as number), existingPayment.payment_method, `REFUND ${invoice.invoice_number}`, user?.email || 'system').run();

      const refundPaymentId = refundResult.meta?.last_row_id;
      if (refundPaymentId) {
        const originalLines = await db.prepare(
          `SELECT invoice_item_id, payment_item_id, description, amount FROM payment_line_items WHERE payment_id = ?`
        ).bind(existingPayment.id).all();
        for (const line of (originalLines.results || []) as any[]) {
          await db.prepare(
            `INSERT INTO payment_line_items (payment_id, invoice_item_id, payment_item_id, description, amount)
             VALUES (?, ?, ?, ?, ?)`
          ).bind(refundPaymentId, line.invoice_item_id, line.payment_item_id, `Refund: ${line.description}`, -line.amount).run();
        }
      }
      success = 'Invoice cancelled, payment refund recorded, and member balance adjusted';
    } else {
      success = 'Invoice cancelled and member balance adjusted';
    }

  } else if (action === 'revert_draft') {
    await db.prepare(`UPDATE members SET account_balance = account_balance - ? WHERE id = ?`).bind(invoice.total, invoice.member_id).run();
    await db.prepare(`UPDATE invoices SET status = 'draft', updated_at = datetime('now') WHERE id = ?`).bind(id).run();
    success = 'Invoice reverted to unpaid and member balance adjusted';

  } else if (action === 'delete') {
    await db.prepare(`DELETE FROM payment_line_items WHERE payment_id IN (SELECT id FROM payments WHERE invoice_id = ?)`).bind(id).run();
    await db.prepare(`DELETE FROM payments WHERE invoice_id = ?`).bind(id).run();
    await db.prepare(`DELETE FROM invoice_items WHERE invoice_id = ?`).bind(id).run();
    await db.prepare(`DELETE FROM invoices WHERE id = ?`).bind(id).run();
    await db.prepare(`UPDATE members SET date_renewed = NULL WHERE id = ?`).bind(invoice.member_id).run();
    // Recalculate balance from remaining draft invoices — immune to all edge cases
    // (manually marked paid, payment records deleted separately, etc.)
    await db.prepare(
      `UPDATE members SET account_balance = -(
         COALESCE((SELECT SUM(i.total) FROM invoices i WHERE i.member_id = ? AND i.status = 'draft'), 0)
       ) WHERE id = ?`
    ).bind(invoice.member_id, invoice.member_id).run();
    await db.prepare(
      `INSERT INTO audit_log (user_email, action, entity_type, entity_id, details) VALUES (?, 'delete_invoice', 'invoice', ?, ?)`
    ).bind(user?.email || 'system', id, JSON.stringify({ invoice_number: invoice.invoice_number })).run();
    return Astro.redirect('/admin/invoices?deleted=1');
  }

  if (action !== 'delete') {
    await db.prepare(
      `INSERT INTO audit_log (user_email, action, entity_type, entity_id, details) VALUES (?, ?, 'invoice', ?, ?)`
    ).bind(user?.email || 'system', action, id, JSON.stringify({ invoice_number: invoice.invoice_number })).run();
  }

  // Refresh invoice and member after any mutation
  const refreshedInvoice = await db.prepare(`SELECT * FROM invoices WHERE id = ?`).bind(id).first<Invoice>();
  if (refreshedInvoice) Object.assign(invoice, refreshedInvoice);
  const refreshedMember = await db.prepare(`SELECT * FROM members WHERE id = ?`).bind(invoice.member_id).first<Member>();
  if (refreshedMember) Object.assign(member, refreshedMember);
}

// Load items and linked family after any POST mutations
const itemsResult = await db.prepare(
  `SELECT ii.*, pi.name as payment_item_name
   FROM invoice_items ii
   LEFT JOIN payment_items pi ON ii.payment_item_id = pi.id
   WHERE ii.invoice_id = ?
   ORDER BY ii.id`
).bind(id).all();
const items = (itemsResult.results || []) as (InvoiceItem & { payment_item_name?: string; linked_member_id?: number })[];

const linkedFamilyResult = await db.prepare(
  `SELECT DISTINCT m.id, m.first_name, m.surname, m.category
   FROM invoice_items ii
   JOIN members m ON ii.linked_member_id = m.id
   WHERE ii.invoice_id = ?`
).bind(id).all();
const linkedFamily = (linkedFamilyResult.results || []) as { id: number; first_name: string; surname: string; category: string }[];

const emailPreview = generateInvoiceEmail({ member, invoice, items, settings });
const statusLabel = invoice.status === 'draft' ? 'UNPAID' : invoice.status.toUpperCase();
const statusClass = invoice.status === 'paid' ? 'status-paid' : invoice.status === 'cancelled' ? 'status-cancelled' : 'status-draft';
const isDraft = invoice.status === 'draft';
---

<AdminLayout title={`Invoice ${invoice.invoice_number}`}>
  <div class="detail-page">

    {error && (
      <div class="m3-alert m3-alert-error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        {error}
      </div>
    )}
    {success && (
      <div class="m3-alert m3-alert-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        {success}
      </div>
    )}

    <!-- Page Header -->
    <div class="page-header">
      <div class="header-left">
        <a href="/admin/invoices" class="back-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
        <div>
          <div class="header-title-row">
            <h1>{invoice.invoice_number}</h1>
            <span class={`status-pill ${statusClass}`}>{statusLabel}</span>
          </div>
          <p class="header-subtitle">{getFullName(member)} &middot; {formatInvoicePeriod(invoice.period_start, invoice.period_end)}</p>
        </div>
      </div>
      <div class="header-actions">
        {isDraft && (
          <>
            <form method="POST" class="action-form">
              <input type="hidden" name="action" value="mark_paid" />
              <select name="payment_method" class="method-select">
                {['BACS','Clubwise Direct Debit','Standing Order','Cheque','Cash','Card','Over the Till'].map(m => (
                  <option value={m} selected={member.default_payment_method === m}>{m}</option>
                ))}
              </select>
              <button type="submit" class="btn btn-filled">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                Mark Paid
              </button>
            </form>
            <a href={`/admin/invoices/preview?ids=${invoice.id}`} class="btn btn-tonal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              Send
            </a>
            <form method="POST" class="action-form" data-confirm="cancel">
              <input type="hidden" name="action" value="cancel" />
              <button type="submit" class="btn btn-danger-outline">Cancel</button>
            </form>
          </>
        )}
        {(invoice.status === 'cancelled' || invoice.status === 'paid') && (
          <form method="POST" class="action-form">
            <input type="hidden" name="action" value="revert_draft" />
            <button type="submit" class="btn btn-tonal">Revert to Unpaid</button>
          </form>
        )}
        {(isDraft || invoice.status === 'cancelled') && (
          <form method="POST" class="action-form" data-confirm="delete">
            <input type="hidden" name="action" value="delete" />
            <button type="submit" class="btn btn-danger-outline">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              Delete
            </button>
          </form>
        )}
        <button type="button" class="btn btn-tonal" onclick="window.print()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          Print
        </button>
      </div>
    </div>

    <!-- Content Grid -->
    <div class="content-grid">
      <div class="main-col">

        <!-- Invoice Details -->
        <div class="m3-card">
          <div class="m3-card-header"><h2>Invoice Details</h2></div>
          <div class="detail-grid">
            <div class="detail-item">
              <span class="detail-label">Invoice Number</span>
              <span class="detail-value detail-value-lg">{invoice.invoice_number}</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Invoice Date</span>
              <span class="detail-value">{formatDate(invoice.invoice_date)}</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Period</span>
              <span class="detail-value">{formatInvoicePeriod(invoice.period_start, invoice.period_end)}</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Total</span>
              <span class="detail-value detail-value-lg detail-value-green">{formatCurrency(invoice.total)}</span>
            </div>
          </div>
          {invoice.sent_at && (
            <div class="sent-info">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              <span>Sent {formatDate(invoice.sent_at)} to <strong>{invoice.sent_to_email}</strong></span>
            </div>
          )}
          {invoice.custom_message && (
            <div class="custom-message">
              <span class="detail-label">Custom Message</span>
              <p>{invoice.custom_message}</p>
            </div>
          )}
        </div>

        <!-- Line Items -->
        <div class="m3-card">
          <div class="m3-card-header">
            <h2>Line Items</h2>
            <span class="item-count">{items.length} item{items.length !== 1 ? 's' : ''}</span>
          </div>
          <div class="table-wrapper">
            <table class="m3-table">
              <thead>
                <tr>
                  <th>Description</th>
                  <th class="text-center">Qty</th>
                  <th class="text-right">Unit Price</th>
                  <th class="text-right">Total</th>
                  {isDraft && <th class="text-center no-print"></th>}
                </tr>
              </thead>
              <tbody>
                {items.map((item) => (
                  <tr class={item.linked_member_id ? 'linked-item-row' : ''}>
                    <td>
                      {item.description}
                      {item.linked_member_id && <span class="linked-badge">family</span>}
                    </td>
                    <td class="text-center">{item.quantity}</td>
                    <td class="text-right">{formatCurrency(item.unit_price)}</td>
                    <td class="text-right fw-500">{formatCurrency(item.line_total)}</td>
                    {isDraft && (
                      <td class="text-center no-print">
                        <form method="POST" class="inline-form" data-confirm="remove-item">
                          <input type="hidden" name="action" value="remove_line_item" />
                          <input type="hidden" name="item_id" value={item.id} />
                          <button type="submit" class="icon-btn icon-btn-danger" title="Remove item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                          </button>
                        </form>
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr class="subtotal-row">
                  <td colspan={isDraft ? 4 : 3} class="text-right">Subtotal</td>
                  <td class="text-right">{formatCurrency(invoice.subtotal)}</td>
                </tr>
                <tr class="total-row">
                  <td colspan={isDraft ? 4 : 3} class="text-right">Total</td>
                  <td class="text-right">{formatCurrency(invoice.total)}</td>
                </tr>
              </tfoot>
            </table>
          </div>

          {isDraft && (
            <div class="add-item-section no-print">
              <h3 class="add-item-heading">Add Item</h3>
              <form method="POST" class="add-item-form" id="add-item-form">
                <input type="hidden" name="action" value="add_line_item" />
                <div class="add-item-row">
                  <select name="payment_item_id" id="item-select" class="item-select">
                    <option value="">Custom item</option>
                    <optgroup label="— Fees —">
                      {feePaymentItems.map(pi => (
                        <option value={pi.id} data-fee={pi.fee} data-name={pi.name}>{pi.name} — {formatCurrency(pi.fee)}</option>
                      ))}
                    </optgroup>
                    <optgroup label="— Subscriptions —">
                      {subPaymentItems.map(pi => (
                        <option value={pi.id} data-fee={pi.fee} data-name={pi.name}>{pi.name} — {formatCurrency(pi.fee)}</option>
                      ))}
                    </optgroup>
                  </select>
                  <input type="text" name="description" id="item-description" class="item-description" placeholder="Description" required />
                  <input type="number" name="unit_price" id="item-price" class="item-price" placeholder="0.00" min="0" step="0.01" required />
                  <input type="number" name="quantity" id="item-quantity" class="item-quantity" value="1" min="1" />
                  <button type="submit" class="btn btn-filled btn-sm">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Add
                  </button>
                </div>
              </form>
            </div>
          )}
        </div>

        {isDraft && (
          <div class="m3-card no-print">
            <div class="m3-card-header">
              <h2>Linked Family Members</h2>
              <span class="item-count">{linkedFamily.length} linked</span>
            </div>

            {linkedFamily.length > 0 && (
              <div class="linked-members-list">
                {linkedFamily.map(fm => (
                  <div class="linked-member-row">
                    <div class="linked-member-info">
                      <a href={`/admin/members/${fm.id}`} class="linked-member-name">{fm.first_name} {fm.surname}</a>
                      <span class="category-badge">{fm.category}</span>
                    </div>
                    <form method="POST" class="inline-form" data-confirm="unlink">
                      <input type="hidden" name="action" value="unlink_family_member" />
                      <input type="hidden" name="family_member_id" value={fm.id} />
                      <button type="submit" class="btn btn-danger-outline btn-sm">Unlink</button>
                    </form>
                  </div>
                ))}
              </div>
            )}

            <div class="family-search-section">
              <p class="family-search-label">Link a member to this invoice — adds their fees and sets them as a family dependant:</p>
              <div class="family-search-input-row">
                <input type="text" id="family-search-input" class="family-search-input" placeholder="Search by name…" autocomplete="off" />
              </div>
              <div id="family-search-results" class="family-search-results"></div>
              <form method="POST" id="link-member-form" style="display:none">
                <input type="hidden" name="action" value="link_family_member" />
                <input type="hidden" name="family_member_id" id="link-member-id" />
                <div class="selected-member-preview" id="selected-member-preview">
                  <div class="selected-member-info">
                    <span id="selected-member-name" class="selected-name"></span>
                    <span id="selected-member-category" class="category-badge"></span>
                    <span id="selected-member-fee" class="selected-fee"></span>
                  </div>
                  <button type="submit" class="btn btn-filled btn-sm">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                    Link to Invoice
                  </button>
                  <button type="button" class="btn btn-tonal btn-sm" id="clear-selection">Clear</button>
                </div>
              </form>
            </div>
          </div>
        )}

        <!-- Email Preview -->
        <div class="m3-card">
          <div class="m3-card-header">
            <h2>Email Preview</h2>
            <button type="button" class="btn btn-tonal btn-sm" onclick="toggleEmailPreview()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              Show/Hide
            </button>
          </div>
          <div id="email-preview" style="display: none;">
            <iframe id="email-iframe" class="email-frame" srcdoc={emailPreview}></iframe>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="sidebar-col">
        <div class="m3-card">
          <div class="m3-card-header"><h2>Member</h2></div>
          <div class="member-info">
            <a href={`/admin/members/${member.id}`} class="member-name">{getFullName(member)}</a>
            <span class="member-pin">M{member.pin?.padStart(4, '0')}</span>
            <span class="category-badge">{member.category}</span>
          </div>
          <div class="member-contact">
            {member.email && (
              <div class="contact-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <span>{member.email}</span>
              </div>
            )}
            {member.telephone_1 && (
              <div class="contact-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <span>{member.telephone_1}</span>
              </div>
            )}
          </div>
          {getFullAddress(member) && (
            <div class="member-address">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>{getFullAddress(member)}</span>
            </div>
          )}
        </div>

        <div class="m3-card">
          <div class="m3-card-header"><h2>Audit Trail</h2></div>
          <div class="audit-list">
            <div class="audit-row">
              <span class="audit-label">Created</span>
              <span class="audit-value">{formatDate(invoice.created_at)}</span>
            </div>
            {invoice.created_by && (
              <div class="audit-row">
                <span class="audit-label">By</span>
                <span class="audit-value">{invoice.created_by}</span>
              </div>
            )}
            <div class="audit-row">
              <span class="audit-label">Updated</span>
              <span class="audit-value">{formatDate(invoice.updated_at)}</span>
            </div>
          </div>
        </div>

        <div class="m3-card">
          <div class="m3-card-header"><h2>Other Invoices</h2></div>
          <div id="related-invoices" class="related-invoices">
            <div class="loading-placeholder">Loading...</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>

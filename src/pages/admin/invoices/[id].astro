<script define:vars={{ memberId: member.id, currentInvoiceId: invoice.id, invoiceMemberId: invoice.member_id }}>
  window.toggleEmailPreview = function() {
    const preview = document.getElementById('email-preview');
    if (preview) preview.style.display = preview.style.display === 'none' ? 'block' : 'none';
  };

  // Load related invoices
  fetch(`/api/member-invoices?member_id=${memberId}&exclude=${currentInvoiceId}`)
    .then(res => res.json())
    .then(data => {
      const container = document.getElementById('related-invoices');
      if (!container) return;
      if (!data.invoices || data.invoices.length === 0) {
        container.innerHTML = '<p style="color:#888;margin:0;">No other invoices</p>';
        return;
      }
      container.innerHTML = data.invoices.map(inv => {
        const sc = inv.status === 'paid' ? 'rs-paid' : inv.status === 'cancelled' ? 'rs-cancelled' : 'rs-draft';
        const sl = inv.status === 'draft' ? 'unpaid' : inv.status;
        return `<div class="related-item"><a href="/admin/invoices/${inv.id}">${inv.invoice_number}</a><span class="related-status ${sc}">${sl}</span></div>`;
      }).join('');
    })
    .catch(() => {
      const c = document.getElementById('related-invoices');
      if (c) c.innerHTML = '<p style="color:#888;margin:0;">Could not load</p>';
    });

  // Add item: auto-fill description and price from selected payment item
  const itemSelect = document.getElementById('item-select');
  const itemDesc = document.getElementById('item-description');
  const itemPrice = document.getElementById('item-price');
  if (itemSelect && itemDesc && itemPrice) {
    itemSelect.addEventListener('change', function() {
      const opt = this.options[this.selectedIndex];
      const fee = opt.dataset.fee;
      const name = opt.dataset.name;
      if (name) {
        itemDesc.value = name;
        itemPrice.value = fee || '';
      } else {
        itemDesc.value = '';
        itemPrice.value = '';
      }
      itemDesc.focus();
    });
  }

  // Family member search
  const familySearchInput = document.getElementById('family-search-input');
  const familySearchResults = document.getElementById('family-search-results');
  const linkMemberForm = document.getElementById('link-member-form');
  const linkMemberId = document.getElementById('link-member-id');
  const selectedPreview = document.getElementById('selected-member-preview');
  const selectedName = document.getElementById('selected-member-name');
  const selectedCategory = document.getElementById('selected-member-category');
  const selectedFee = document.getElementById('selected-member-fee');
  const clearSelection = document.getElementById('clear-selection');

  let searchTimer = null;

  function formatCurrencyJS(amount) {
    return '£' + parseFloat(amount).toFixed(2);
  }

  function selectMember(id, name, category, fee) {
    linkMemberId.value = id;
    selectedName.textContent = name;
    selectedCategory.textContent = category;
    selectedFee.textContent = fee > 0 ? formatCurrencyJS(fee) + ' subscription' : 'No subscription fee';
    linkMemberForm.style.display = 'block';
    familySearchResults.innerHTML = '';
    familySearchInput.value = name;
  }

  if (clearSelection) {
    clearSelection.addEventListener('click', () => {
      linkMemberForm.style.display = 'none';
      familySearchInput.value = '';
      familySearchResults.innerHTML = '';
    });
  }

  if (familySearchInput) {
    familySearchInput.addEventListener('input', function() {
      clearTimeout(searchTimer);
      const q = this.value.trim();
      if (q.length < 2) { familySearchResults.innerHTML = ''; return; }
      searchTimer = setTimeout(() => {
        fetch(`/api/member-search?q=${encodeURIComponent(q)}&exclude=${invoiceMemberId}&exclude_linked=1`)
          .then(r => r.json())
          .then(data => {
            if (!data.members || data.members.length === 0) {
              familySearchResults.innerHTML = '<p style="color:#888;font-size:0.85rem;margin:0.25rem 0;">No members found</p>';
              return;
            }
            familySearchResults.innerHTML = data.members.map(m => `
              <div class="search-result-row" onclick="selectMember(${m.id}, '${m.first_name} ${m.surname}', '${m.category}', ${m.subscription_fee})">
                <div class="search-result-info">
                  <strong>${m.first_name} ${m.surname}</strong>
                  <span style="background:#e8f5e9;color:#1e5631;padding:0.1rem 0.45rem;border-radius:100px;font-size:0.7rem;font-weight:600;">${m.category}</span>
                </div>
                <span class="search-result-fee">${m.subscription_fee > 0 ? formatCurrencyJS(m.subscription_fee) : 'No fee'}</span>
              </div>`).join('');
          })
          .catch(() => { familySearchResults.innerHTML = '<p style="color:#888;font-size:0.85rem;">Search failed</p>'; });
      }, 300);
    });
  }

  window.selectMember = selectMember;

  // Confirmation dialogs
  document.querySelectorAll('form[data-confirm]').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const confirmType = form.dataset.confirm;
      let confirmed = false;

      if (confirmType === 'cancel') {
        confirmed = await m3Confirm('Are you sure you want to cancel this invoice?', { title: 'Cancel Invoice?', type: 'warning', confirmText: 'Cancel Invoice', cancelText: 'Keep It', danger: true });
      } else if (confirmType === 'delete') {
        confirmed = await m3Confirm('This will permanently delete this invoice. This cannot be undone.', { title: 'Delete Invoice?', type: 'delete', confirmText: 'Delete', cancelText: 'Keep It', danger: true });
      } else if (confirmType === 'remove-item') {
        confirmed = await m3Confirm('Remove this line item from the invoice?', { title: 'Remove Item?', type: 'warning', confirmText: 'Remove', cancelText: 'Keep It', danger: true });
      } else if (confirmType === 'unlink') {
        confirmed = await m3Confirm('Unlink this family member? Their items will be removed from the invoice.', { title: 'Unlink Member?', type: 'warning', confirmText: 'Unlink', cancelText: 'Keep Linked', danger: true });
      }

      if (confirmed) form.submit();
    });
  });
</script>

---
import AdminLayout from '@/layouts/AdminLayout.astro';

// Transactions are fetched live from Sage via the explorer API
// This page provides a structured view with date filtering
---

<AdminLayout title="Transactions">
  <div class="card">
    <div class="card-header">
      <span class="card-title">Bank Transactions</span>
    </div>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: end;">
      <div>
        <label style="font-size: 0.75rem; color: var(--text-light);">From</label>
        <input type="date" id="from-date" class="form-input">
      </div>
      <div>
        <label style="font-size: 0.75rem; color: var(--text-light);">To</label>
        <input type="date" id="to-date" class="form-input">
      </div>
      <div>
        <label style="font-size: 0.75rem; color: var(--text-light);">Type</label>
        <select id="txn-type" class="form-input">
          <option value="">All types</option>
          <option value="bank_transactions">Bank transactions</option>
          <option value="sales_invoices">Sales invoices</option>
          <option value="purchase_invoices">Purchase invoices</option>
          <option value="other_payments">Other payments</option>
          <option value="journals">Journals</option>
          <option value="ledger_entries">Ledger entries</option>
        </select>
      </div>
      <button class="btn btn-primary" onclick="fetchTransactions()">Fetch</button>
    </div>
  </div>

  <div id="loading" style="display: none; text-align: center; padding: 2rem;">
    <span class="loading" style="width: 40px; height: 40px; border-width: 3px;"></span>
    <p class="text-muted" style="margin-top: 1rem;">Fetching from Sage API...</p>
  </div>

  <div id="summary" style="display: none;" class="stats-grid"></div>

  <div id="results" style="display: none;" class="card">
    <div class="card-header">
      <span class="card-title" id="result-title">Results</span>
      <span id="result-count" class="badge badge-info"></span>
    </div>
    <div class="table-container">
      <table id="txn-table">
        <thead><tr id="txn-header"></tr></thead>
        <tbody id="txn-body"></tbody>
      </table>
    </div>
  </div>

  <div id="error-container" style="display: none;"></div>

  <style>
    .form-input {
      padding: 0.5rem 0.625rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 0.875rem;
      font-family: inherit;
      background: var(--white);
    }
    .form-input:focus {
      outline: none;
      border-color: var(--primary);
    }
    .table-container { overflow-x: auto; }
  </style>

  <script is:inline>
    // Default to current financial year
    const now = new Date();
    // Sage financial year typically April-March for UK
    const fyStart = now.getMonth() >= 3
      ? new Date(now.getFullYear(), 3, 1)
      : new Date(now.getFullYear() - 1, 3, 1);
    document.getElementById('from-date').value = fyStart.toISOString().split('T')[0];
    document.getElementById('to-date').value = now.toISOString().split('T')[0];

    async function fetchTransactions() {
      const fromDate = document.getElementById('from-date').value;
      const toDate = document.getElementById('to-date').value;
      const txnType = document.getElementById('txn-type').value || 'bank_transactions';

      document.getElementById('loading').style.display = 'block';
      document.getElementById('results').style.display = 'none';
      document.getElementById('summary').style.display = 'none';
      document.getElementById('error-container').style.display = 'none';

      let url = `/api/sage/explore?endpoint=/${txnType}&items_per_page=200`;
      if (fromDate) url += `&from_date=${fromDate}`;
      if (toDate) url += `&to_date=${toDate}`;

      try {
        const res = await fetch(url);
        const data = await res.json();
        document.getElementById('loading').style.display = 'none';

        if (data.error) {
          document.getElementById('error-container').innerHTML = `<div class="alert alert-error">${data.error}</div>`;
          document.getElementById('error-container').style.display = 'block';
          return;
        }

        const items = data.$items || [];
        document.getElementById('result-title').textContent = txnType.replace(/_/g, ' ');
        document.getElementById('result-count').textContent = `${items.length} of ${data.$total || items.length}`;

        // Build a table from the first item's keys
        const header = document.getElementById('txn-header');
        const body = document.getElementById('txn-body');
        header.innerHTML = '';
        body.innerHTML = '';

        if (items.length === 0) {
          body.innerHTML = '<tr><td colspan="10" style="text-align: center; color: var(--text-light);">No results</td></tr>';
          document.getElementById('results').style.display = 'block';
          return;
        }

        // Pick interesting columns based on type
        const columnMap = {
          bank_transactions: ['date', 'displayed_as', 'transaction_type', 'total', 'reference', 'contact'],
          sales_invoices: ['date', 'displayed_as', 'contact', 'total_amount', 'outstanding_amount', 'status'],
          purchase_invoices: ['date', 'displayed_as', 'contact', 'total_amount', 'outstanding_amount', 'status'],
          other_payments: ['date', 'displayed_as', 'total_amount', 'tax_amount', 'payment_method'],
          journals: ['date', 'displayed_as', 'reference', 'description', 'total'],
          ledger_entries: ['date', 'displayed_as', 'ledger_account', 'debit', 'credit', 'description'],
        };

        const cols = columnMap[txnType] || Object.keys(items[0]).filter(k => !k.startsWith('$') && k !== 'id' && typeof items[0][k] !== 'object');

        cols.forEach(c => {
          const th = document.createElement('th');
          th.textContent = c.replace(/_/g, ' ');
          header.appendChild(th);
        });

        // Calculate totals for summary
        let totalAmount = 0;
        let countByType = {};

        items.forEach(item => {
          const tr = document.createElement('tr');
          cols.forEach(c => {
            const td = document.createElement('td');
            let val = item[c];
            // Handle nested objects
            if (val && typeof val === 'object') {
              val = val.displayed_as || val.name || val.id || JSON.stringify(val);
            }
            td.textContent = val != null ? String(val) : '-';
            if (c.includes('amount') || c === 'total' || c === 'debit' || c === 'credit') {
              td.style.textAlign = 'right';
              td.style.fontFamily = 'monospace';
            }
            tr.appendChild(td);
          });
          body.appendChild(tr);

          // Accumulate for summary
          const amt = parseFloat(item.total_amount || item.total || 0);
          if (!isNaN(amt)) totalAmount += amt;
          const type = item.transaction_type?.displayed_as || item.status?.displayed_as || 'Other';
          countByType[type] = (countByType[type] || 0) + 1;
        });

        // Show summary
        const summaryEl = document.getElementById('summary');
        summaryEl.innerHTML = `
          <div class="stat-card">
            <div class="stat-value">${items.length}</div>
            <div class="stat-label">Records returned</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">${totalAmount.toLocaleString('en-GB', {style: 'currency', currency: 'GBP'})}</div>
            <div class="stat-label">Total amount</div>
          </div>
          ${Object.entries(countByType).map(([t, c]) => `
            <div class="stat-card">
              <div class="stat-value">${c}</div>
              <div class="stat-label">${t}</div>
            </div>
          `).join('')}
        `;
        summaryEl.style.display = 'grid';

        document.getElementById('results').style.display = 'block';
      } catch (e) {
        document.getElementById('loading').style.display = 'none';
        document.getElementById('error-container').innerHTML = `<div class="alert alert-error">Failed: ${e.message}</div>`;
        document.getElementById('error-container').style.display = 'block';
      }
    }
  </script>
</AdminLayout>

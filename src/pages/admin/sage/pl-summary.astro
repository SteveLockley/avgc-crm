---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { lastDayOfMonth } from '@/lib/pl-report';
import { renderPLReportHtml } from '@/lib/pl-report-html';
import type { PLReportData } from '@/lib/pl-report';

const env = Astro.locals.runtime?.env;
const db = env?.DB;

// Default to the most recently completed month.
const now = new Date();
const defaultMonth = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1));
defaultMonth.setUTCMonth(defaultMonth.getUTCMonth() - 1);
const defaultMonthStr = defaultMonth.toISOString().slice(0, 7);

const month = /^\d{4}-\d{2}$/.test(Astro.url.searchParams.get('month') || '')
  ? Astro.url.searchParams.get('month')!
  : defaultMonthStr;
const periodEnd = lastDayOfMonth(month);

function monthLabel(ym: string): string {
  const [y, m] = ym.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
}

// Dropdown options: trailing 18 months up to the most recently completed one.
const monthOptions: string[] = [];
{
  const cursor = new Date(defaultMonth);
  for (let i = 0; i < 18; i++) {
    monthOptions.push(cursor.toISOString().slice(0, 7));
    cursor.setUTCMonth(cursor.getUTCMonth() - 1);
  }
}

let reportRow: any = null;
let previousReports: any[] = [];
let recipients: any[] = [];
let dbError = '';

if (db) {
  try {
    reportRow = await db.prepare(
      'SELECT data, generated_at, generated_by, sent_at, sent_to FROM pl_reports WHERE period_end = ?'
    ).bind(periodEnd).first();

    const prev = await db.prepare(
      'SELECT period_end, generated_at, sent_at, sent_to FROM pl_reports ORDER BY period_end DESC LIMIT 24'
    ).all();
    previousReports = prev.results as any[];

    const rec = await db.prepare(
      'SELECT id, email, name FROM pl_report_recipients WHERE active = 1 ORDER BY email'
    ).all();
    recipients = rec.results as any[];
  } catch (e: any) {
    dbError = e.message;
  }
}

const data: PLReportData | null = reportRow ? JSON.parse(reportRow.data) : null;
const previewHtml = data ? renderPLReportHtml(data) : '';
---

<AdminLayout title="Income & Expenditure (Cash Based)">

  {dbError && <div class="alert alert-error">{dbError}</div>}

  <div class="pls-header">
    <h2 class="pls-title">Income &amp; Expenditure (Cash Based)</h2>
    <select id="month-select" class="form-input pls-month-select" onchange="location.href='?month='+this.value">
      {monthOptions.map(m => (
        <option value={m} selected={m === month}>{monthLabel(m)}</option>
      ))}
    </select>
  </div>

  <div class="pls-layout">

    <div class="pls-main">
      <div class="card">
        <div class="card-header">
          <span class="card-title">{monthLabel(month)}</span>
          <div class="pls-actions">
            <button id="generate-btn" class="btn btn-secondary btn-sm" data-month={month}>
              {data ? 'Regenerate from Sage' : 'Generate Report'}
            </button>
            {data && <button id="send-btn" class="btn btn-primary btn-sm" data-month={month}>Send Now</button>}
          </div>
        </div>

        {data ? (
          <>
            <p class="pls-meta">
              Generated {new Date(reportRow.generated_at + 'Z').toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}
              {reportRow.generated_by && <> by {reportRow.generated_by}</>}
              {reportRow.sent_at ? (
                <> &middot; <span class="badge badge-success">Sent</span> {new Date(reportRow.sent_at + 'Z').toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })} to {reportRow.sent_to}</>
              ) : (
                <> &middot; <span class="badge badge-warning">Not yet sent</span></>
              )}
            </p>
            <div id="send-status"></div>
            <iframe id="preview-frame" class="pls-preview" srcdoc={previewHtml} title="Income & Expenditure report preview"></iframe>
          </>
        ) : (
          <p class="pls-empty">No report has been generated for {monthLabel(month)} yet. Click "Generate Report" to pull the figures from Sage.</p>
        )}
        <div id="generate-status"></div>
      </div>
    </div>

    <div class="pls-side">
      <div class="card">
        <div class="card-header"><span class="card-title">Recipients</span></div>
        <ul class="pls-recipients">
          {recipients.map(r => (
            <li>
              <span>{r.name ? `${r.name} <${r.email}>` : r.email}</span>
              <button class="pls-remove-recipient" data-id={r.id} title="Remove">&times;</button>
            </li>
          ))}
          {recipients.length === 0 && <li class="pls-empty-sm">No recipients yet.</li>}
        </ul>
        <form id="add-recipient-form" class="pls-add-form">
          <input type="email" id="recipient-email" class="form-input" placeholder="email@example.com" required />
          <input type="text" id="recipient-name" class="form-input" placeholder="Name (optional)" />
          <button type="submit" class="btn btn-secondary btn-sm">Add</button>
        </form>
        <div id="recipient-status"></div>
      </div>

      <div class="card">
        <div class="card-header"><span class="card-title">Previous Reports</span></div>
        <ul class="pls-history">
          {previousReports.map(r => (
            <li class={r.period_end === periodEnd ? 'active' : ''}>
              <a href={`?month=${r.period_end.slice(0, 7)}`}>{monthLabel(r.period_end.slice(0, 7))}</a>
              {r.sent_at ? <span class="badge badge-success">Sent</span> : <span class="badge badge-warning">Draft</span>}
            </li>
          ))}
          {previousReports.length === 0 && <li class="pls-empty-sm">No reports generated yet.</li>}
        </ul>
      </div>
    </div>

  </div>

  <style>
    .pls-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .pls-title { font-size: 1.125rem; font-weight: 600; margin: 0; }
    .pls-month-select { width: auto; min-width: 12rem; }

    .pls-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    @media (min-width: 960px) {
      .pls-layout { grid-template-columns: 2fr 1fr; align-items: start; }
    }

    .pls-actions { display: flex; gap: 0.5rem; }
    .pls-meta { font-size: 0.8rem; color: var(--text-light); margin: 0 0 1rem; }
    .pls-empty, .pls-empty-sm { color: var(--text-light); font-size: 0.875rem; }
    .pls-empty-sm { font-size: 0.8rem; }

    .pls-preview {
      width: 100%;
      height: 1400px;
      border: 1px solid var(--border);
      border-radius: 8px;
    }

    .pls-recipients { list-style: none; margin: 0 0 1rem; padding: 0; }
    .pls-recipients li {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.4rem 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.8rem;
    }
    .pls-remove-recipient {
      background: none;
      border: none;
      color: var(--danger);
      cursor: pointer;
      font-size: 1rem;
      line-height: 1;
      padding: 0 0.25rem;
    }
    .pls-add-form { display: flex; flex-direction: column; gap: 0.5rem; }

    .pls-history { list-style: none; margin: 0; padding: 0; }
    .pls-history li {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.4rem 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.8rem;
    }
    .pls-history li.active a { font-weight: 700; }
    .pls-history a { color: var(--text); text-decoration: none; }
    .pls-history a:hover { color: var(--primary); }

    #generate-status, #send-status, #recipient-status { font-size: 0.8rem; margin-top: 0.5rem; }
    .pls-ok { color: var(--success); }
    .pls-err { color: var(--danger); }
  </style>

  <script>
    async function postAction(body: any) {
      const res = await fetch('/api/sage/pl-report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      return { ok: res.ok, data };
    }

    const generateBtn = document.getElementById('generate-btn');
    generateBtn?.addEventListener('click', async () => {
      const month = (generateBtn as HTMLElement).dataset.month!;
      const statusEl = document.getElementById('generate-status')!;
      (generateBtn as HTMLButtonElement).disabled = true;
      statusEl.textContent = 'Fetching figures from Sage…';
      statusEl.className = '';
      const { ok, data } = await postAction({ action: 'generate', month });
      if (ok) {
        location.reload();
      } else {
        statusEl.textContent = data.error || 'Failed to generate report.';
        statusEl.className = 'pls-err';
        (generateBtn as HTMLButtonElement).disabled = false;
      }
    });

    const sendBtn = document.getElementById('send-btn');
    sendBtn?.addEventListener('click', async () => {
      const month = (sendBtn as HTMLElement).dataset.month!;
      const statusEl = document.getElementById('send-status')!;
      if (!confirm('Send this Income & Expenditure report to all active recipients now?')) return;
      (sendBtn as HTMLButtonElement).disabled = true;
      statusEl.textContent = 'Sending…';
      statusEl.className = '';
      const { ok, data } = await postAction({ action: 'send', month });
      if (ok) {
        statusEl.textContent = `Sent to ${data.sent} recipient(s).` + (data.failed?.length ? ` Failed: ${data.failed.join(', ')}` : '');
        statusEl.className = 'pls-ok';
        setTimeout(() => location.reload(), 1500);
      } else {
        statusEl.textContent = data.error || 'Failed to send.';
        statusEl.className = 'pls-err';
        (sendBtn as HTMLButtonElement).disabled = false;
      }
    });

    document.getElementById('add-recipient-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('recipient-email') as HTMLInputElement;
      const nameInput = document.getElementById('recipient-name') as HTMLInputElement;
      const statusEl = document.getElementById('recipient-status')!;
      const { ok, data } = await postAction({ action: 'add-recipient', email: emailInput.value, name: nameInput.value });
      if (ok) {
        location.reload();
      } else {
        statusEl.textContent = data.error || 'Failed to add recipient.';
        statusEl.className = 'pls-err';
      }
    });

    document.querySelectorAll('.pls-remove-recipient').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        if (!confirm('Remove this recipient?')) return;
        const { ok } = await postAction({ action: 'remove-recipient', id: Number(id) });
        if (ok) location.reload();
      });
    });
  </script>

</AdminLayout>

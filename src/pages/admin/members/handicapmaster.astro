---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatDate, type Member } from '../../../lib/db';

const db = Astro.locals.runtime.env.DB;

interface HMRecord {
  surname: string;
  middleInitials: string;
  firstName: string;
  gender: string;
  ageGroup: string;
  handicapIndex: string;
  homeAway: string;
  homeClub: string;
  pin: string;
  title: string;
  address1: string;
  address2: string;
  address3: string;
  address4: string;
  address5: string;
  telephone1: string;
  telephone2: string;
  telephone3: string;
  email: string;
  clubNumber: string;
  category: string;
  dateJoined: string;
  dateRenewed: string;
  dateExpires: string;
  dateSubscriptionPaid: string;
  nationalIdCountry: string;
  nationalId: string;
  dateOfBirth: string;
  lockerNumber: string;
  defaultPaymentMethod: string;
  subscriptionTemplate: string;
  accountBalance: string;
  sendInvoiceBy: string;
  competitionPurse: string;
}

interface ConsolidationResult {
  matched: Array<{
    hmRecord: HMRecord;
    crmId: number;
    crmName: string;
    crmPin: string;
    differences: string[];
  }>;
  hmNotInCrm: Array<HMRecord>;
  crmNotInHm: Array<{
    crmId: number;
    crmName: string;
    crmPin: string;
    crmCategory: string | null;
  }>;
  errors: string[];
}

let result: ConsolidationResult | null = null;
let error = '';
let successMessage = '';
let lastImport: { imported_at: string; imported_by: string | null } | null = null;
let undoAvailable: { syncedAt: string; updated: number } | null = null;

// Check if undo snapshot exists
const undoData = await db.prepare(
  `SELECT value FROM app_settings WHERE key = 'hm_sync_undo'`
).first<{ value: string }>().catch(() => null);
if (undoData) {
  try {
    const parsed = JSON.parse(undoData.value);
    undoAvailable = { syncedAt: parsed.syncedAt, updated: parsed.updated };
  } catch {}
}

// Load previously saved consolidation data
const savedData = await db.prepare(
  `SELECT * FROM handicapmaster_consolidation ORDER BY imported_at DESC LIMIT 1`
).first<{
  id: number;
  imported_at: string;
  imported_by: string | null;
  matched_count: number;
  hm_not_in_crm_count: number;
  crm_not_in_hm_count: number;
  matched_json: string | null;
  hm_not_in_crm_json: string | null;
  crm_not_in_hm_json: string | null;
  errors_json: string | null;
}>().catch(() => null);

if (savedData) {
  lastImport = { imported_at: savedData.imported_at, imported_by: savedData.imported_by };
  result = {
    matched: savedData.matched_json ? JSON.parse(savedData.matched_json) : [],
    hmNotInCrm: savedData.hm_not_in_crm_json ? JSON.parse(savedData.hm_not_in_crm_json) : [],
    crmNotInHm: savedData.crm_not_in_hm_json ? JSON.parse(savedData.crm_not_in_hm_json) : [],
    errors: savedData.errors_json ? JSON.parse(savedData.errors_json) : []
  };
}

// Parse CSV line handling quoted fields
function parseCSVLine(line: string): string[] {
  const values: string[] = [];
  let current = '';
  let inQuotes = false;

  for (let i = 0; i < line.length; i++) {
    const char = line[i];
    if (char === '"') {
      inQuotes = !inQuotes;
    } else if (char === ',' && !inQuotes) {
      values.push(current.trim());
      current = '';
    } else {
      current += char;
    }
  }
  values.push(current.trim());
  return values;
}

// Parse full CSV handling multi-line quoted fields
function parseCSV(text: string): string[][] {
  const rows: string[][] = [];
  let current = '';
  let inQuotes = false;

  for (let i = 0; i < text.length; i++) {
    const char = text[i];

    if (char === '"') {
      inQuotes = !inQuotes;
      current += char;
    } else if ((char === '\n' || char === '\r') && !inQuotes) {
      if (current.trim()) {
        rows.push(parseCSVLine(current));
      }
      current = '';
      if (char === '\r' && text[i + 1] === '\n') {
        i++;
      }
    } else {
      current += char;
    }
  }

  if (current.trim()) {
    rows.push(parseCSVLine(current));
  }

  return rows;
}

// Normalize name for comparison
function normalizeName(name: string | null): string {
  if (!name) return '';
  return name.toLowerCase().trim().replace(/[^a-z]/g, '');
}

// Parse date from DD/MM/YYYY format to YYYY-MM-DD
function parseDate(dateStr: string): string | null {
  if (!dateStr) return null;
  const parts = dateStr.split('/');
  if (parts.length === 3) {
    const [day, month, year] = parts;
    return `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
  }
  return null;
}

// Parse currency value — strip everything except digits, decimal point, and minus
function parseCurrency(value: string): number {
  if (!value) return 0;
  // Keep only digits, dots, and minus signs (handles any encoding of £ or other currency symbols)
  const cleaned = value.replace(/[^0-9.\-]/g, '');
  return parseFloat(cleaned) || 0;
}

// Get column value safely
function getCol(values: string[], idx: number): string {
  return idx >= 0 && idx < values.length ? values[idx]?.trim() || '' : '';
}

// Calculate age group from date of birth (DD/MM/YYYY or YYYY-MM-DD)
function calculateAgeGroup(dateStr: string | null): string {
  if (!dateStr) return '';
  let dob: Date;
  // Handle DD/MM/YYYY format
  const ddmmyyyy = dateStr.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
  if (ddmmyyyy) {
    dob = new Date(parseInt(ddmmyyyy[3]), parseInt(ddmmyyyy[2]) - 1, parseInt(ddmmyyyy[1]));
  } else {
    dob = new Date(dateStr);
  }
  if (isNaN(dob.getTime())) return '';
  const now = new Date();
  let age = now.getFullYear() - dob.getFullYear();
  const monthDiff = now.getMonth() - dob.getMonth();
  if (monthDiff < 0 || (monthDiff === 0 && now.getDate() < dob.getDate())) age--;
  if (age < 18) return 'Junior';
  if (age < 55) return 'Adult';
  return 'Senior';
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  if (action === 'import') {
    // Import a single member from HandicapMaster
    const hmData = formData.get('hmData') as string;
    try {
      const hm: HMRecord = JSON.parse(hmData);

      // Check if member already exists by PIN or name
      let existingMember = null;
      if (hm.pin) {
        existingMember = await db.prepare(
          'SELECT id FROM members WHERE pin = ?'
        ).bind(hm.pin).first<{ id: number }>();
      }

      if (!existingMember) {
        // Try to find by name
        existingMember = await db.prepare(
          'SELECT id FROM members WHERE LOWER(surname) = LOWER(?) AND LOWER(first_name) = LOWER(?)'
        ).bind(hm.surname, hm.firstName).first<{ id: number }>();
      }

      if (existingMember) {
        error = `Member ${hm.firstName} ${hm.surname} already exists in CRM (ID: ${existingMember.id})`;
      } else {
        // Insert new member
        const insertResult = await db.prepare(`
          INSERT INTO members (
            surname, middle_initials, first_name, gender, age_group, handicap_index,
            home_away, home_club, pin, title, address_1, address_2, address_3, address_4, address_5,
            telephone_1, telephone_2, telephone_3, email, club_number, category,
            date_joined, date_renewed, date_expires, date_subscription_paid,
            national_id_country, national_id, date_of_birth, locker_number,
            default_payment_method, subscription_template, account_balance, send_invoice_by
          ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        `).bind(
          hm.surname,
          hm.middleInitials || null,
          hm.firstName,
          hm.gender || null,
          hm.ageGroup || null,
          hm.handicapIndex ? parseFloat(hm.handicapIndex) : null,
          hm.homeAway || null,
          hm.homeClub || null,
          hm.pin || null,
          hm.title || null,
          hm.address1 || null,
          hm.address2 || null,
          hm.address3 || null,
          hm.address4 || null,
          hm.address5 || null,
          hm.telephone1 || null,
          hm.telephone2 || null,
          hm.telephone3 || null,
          hm.email || null,
          hm.clubNumber || null,
          hm.category || null,
          parseDate(hm.dateJoined),
          parseDate(hm.dateRenewed),
          parseDate(hm.dateExpires),
          parseDate(hm.dateSubscriptionPaid),
          hm.nationalIdCountry || null,
          hm.nationalId || null,
          parseDate(hm.dateOfBirth),
          hm.lockerNumber || null,
          hm.defaultPaymentMethod || null,
          hm.subscriptionTemplate || null,
          parseCurrency(hm.accountBalance),
          hm.sendInvoiceBy || null
        ).run();

        // Auto-generate PIN if HM record didn't have one
        if (!hm.pin) {
          const newMemberId = insertResult.meta.last_row_id;
          if (newMemberId) {
            const usedPins = await db.prepare(
              `SELECT CAST(pin AS INTEGER) as p FROM members WHERE pin IS NOT NULL AND pin != ''`
            ).all();
            const pinSet = new Set((usedPins.results || []).map((r: any) => r.p as number));
            const maxPin = Math.max(0, ...pinSet);
            let newPin = maxPin + 1;
            if (newPin > 9999) {
              newPin = 1;
              while (pinSet.has(newPin) && newPin <= 9999) newPin++;
            }
            if (newPin <= 9999) {
              await db.prepare(
                `UPDATE members SET pin = ? WHERE id = ? AND (pin IS NULL OR pin = '')`
              ).bind(String(newPin), newMemberId).run();
            }
          }
        }

        successMessage = `Successfully imported ${hm.firstName} ${hm.surname}`;

        // Reload saved data to update the list
        const updatedData = await db.prepare(
          `SELECT * FROM handicapmaster_consolidation ORDER BY imported_at DESC LIMIT 1`
        ).first<any>().catch(() => null);

        if (updatedData) {
          // Remove the imported member from hmNotInCrm
          const hmNotInCrm = updatedData.hm_not_in_crm_json ? JSON.parse(updatedData.hm_not_in_crm_json) : [];
          const filteredHmNotInCrm = hmNotInCrm.filter((m: HMRecord) =>
            !(m.surname === hm.surname && m.firstName === hm.firstName && m.pin === hm.pin)
          );

          // Update the stored data
          await db.prepare(
            `UPDATE handicapmaster_consolidation SET hm_not_in_crm_json = ?, hm_not_in_crm_count = ? WHERE id = ?`
          ).bind(JSON.stringify(filteredHmNotInCrm), filteredHmNotInCrm.length, updatedData.id).run();

          result = {
            matched: updatedData.matched_json ? JSON.parse(updatedData.matched_json) : [],
            hmNotInCrm: filteredHmNotInCrm,
            crmNotInHm: updatedData.crm_not_in_hm_json ? JSON.parse(updatedData.crm_not_in_hm_json) : [],
            errors: updatedData.errors_json ? JSON.parse(updatedData.errors_json) : []
          };
          lastImport = { imported_at: updatedData.imported_at, imported_by: updatedData.imported_by };
        }
      }
    } catch (e: any) {
      error = `Failed to import member: ${e.message}`;
    }
  } else if (action === 'sync') {
    // Sync handicap, competition purse, home club, home/away, and age group from HM to CRM
    try {
      const matchedJson = formData.get('matchedData') as string;
      const matched: ConsolidationResult['matched'] = JSON.parse(matchedJson);
      let updated = 0;
      let skipped = 0;

      // Save current values for undo (batch to avoid D1 variable limit)
      const memberIds = matched.map(m => m.crmId);
      const snapshot: Array<{ id: number; handicap_index: any; competition_fee_purse: any; home_club: any; home_away: any; age_group: any }> = [];
      const batchSize = 80;
      for (let i = 0; i < memberIds.length; i += batchSize) {
        const batch = memberIds.slice(i, i + batchSize);
        const placeholders = batch.map(() => '?').join(',');
        const currentValues = await db.prepare(
          `SELECT id, handicap_index, competition_fee_purse, home_club, home_away, age_group
           FROM members WHERE id IN (${placeholders})`
        ).bind(...batch).all();
        for (const r of (currentValues.results || []) as any[]) {
          snapshot.push({
            id: r.id,
            handicap_index: r.handicap_index,
            competition_fee_purse: r.competition_fee_purse,
            home_club: r.home_club,
            home_away: r.home_away,
            age_group: r.age_group,
          });
        }
      }

      for (const m of matched) {
        const hm = m.hmRecord;
        const hmHandicap = hm.handicapIndex ? parseFloat(hm.handicapIndex) : null;
        const purseValue = hm.competitionPurse || hm.accountBalance;
        const hmPurse = purseValue ? parseCurrency(purseValue) : null;
        const hmHomeClub = hm.homeClub || null;
        const hmHomeAway = hm.homeAway ? hm.homeAway.charAt(0).toUpperCase() : null;
        const hmAgeGroup = calculateAgeGroup(hm.dateOfBirth) || null;

        // Build dynamic update
        const sets: string[] = [];
        const values: any[] = [];

        if (hmHandicap !== null && !isNaN(hmHandicap)) {
          sets.push('handicap_index = ?');
          values.push(hmHandicap);
        }
        if (hmPurse !== null) {
          sets.push('competition_fee_purse = ?');
          values.push(hmPurse);
        }
        if (hmHomeClub) {
          sets.push('home_club = ?');
          values.push(hmHomeClub);
        }
        if (hmHomeAway && ['H', 'A', 'V'].includes(hmHomeAway)) {
          sets.push('home_away = ?');
          values.push(hmHomeAway);
        }
        if (hmAgeGroup) {
          sets.push('age_group = ?');
          values.push(hmAgeGroup);
        }

        if (sets.length > 0) {
          await db.prepare(
            `UPDATE members SET ${sets.join(', ')} WHERE id = ?`
          ).bind(...values, m.crmId).run();
          updated++;
        } else {
          skipped++;
        }
      }

      // Store undo snapshot
      await db.prepare(
        `INSERT OR REPLACE INTO app_settings (key, value, updated_at) VALUES ('hm_sync_undo', ?, datetime('now'))`
      ).bind(JSON.stringify({ snapshot, updated, syncedAt: new Date().toISOString() })).run();

      // Re-read CRM values and recalculate differences so the page reflects the sync
      const updatedCrm = new Map<number, any>();
      for (let i = 0; i < memberIds.length; i += batchSize) {
        const batch = memberIds.slice(i, i + batchSize);
        const ph = batch.map(() => '?').join(',');
        const rows = await db.prepare(
          `SELECT id, handicap_index, competition_fee_purse, home_club, home_away, age_group, date_of_birth
           FROM members WHERE id IN (${ph})`
        ).bind(...batch).all();
        for (const r of (rows.results || []) as any[]) {
          updatedCrm.set(r.id, r);
        }
      }

      // Recalculate differences for each matched member
      for (const m of matched) {
        const hm = m.hmRecord;
        const crm = updatedCrm.get(m.crmId);
        if (!crm) continue;
        const diffs: string[] = [];

        if (hm.pin && crm.pin && hm.pin !== crm.pin) {
          diffs.push(`PIN: HM="${hm.pin}" vs CRM="${crm.pin}"`);
        }
        if (hm.handicapIndex && crm.handicap_index !== null) {
          const hmH = parseFloat(hm.handicapIndex);
          if (!isNaN(hmH) && Math.abs(hmH - crm.handicap_index) > 0.1) {
            diffs.push(`Handicap: HM="${hm.handicapIndex}" vs CRM="${crm.handicap_index}"`);
          }
        }
        if (hm.category && crm.category && hm.category !== crm.category) {
          diffs.push(`Category: HM="${hm.category}" vs CRM="${crm.category}"`);
        }
        if (hm.homeAway && crm.home_away && hm.homeAway.charAt(0).toUpperCase() !== crm.home_away) {
          diffs.push(`H/A: HM="${hm.homeAway}" vs CRM="${crm.home_away}"`);
        }
        if (hm.homeClub && crm.home_club && normalizeName(hm.homeClub) !== normalizeName(crm.home_club)) {
          diffs.push(`Home Club: HM="${hm.homeClub}" vs CRM="${crm.home_club}"`);
        }
        const hmAge = calculateAgeGroup(hm.dateOfBirth);
        const crmAge = crm.age_group === 'Playing Ladies' ? calculateAgeGroup(crm.date_of_birth) : crm.age_group;
        if (hmAge && crmAge && hmAge !== crmAge) {
          diffs.push(`Age Group: HM="${hmAge}" vs CRM="${crm.age_group}"`);
        }
        const purseVal = hm.competitionPurse || hm.accountBalance;
        if (purseVal) {
          const hmP = parseCurrency(purseVal);
          const crmP = crm.competition_fee_purse || 0;
          if (Math.abs(hmP - crmP) > 0.01) {
            diffs.push(`Comp Purse: HM="£${hmP.toFixed(2)}" vs CRM="£${crmP.toFixed(2)}"`);
          }
        }
        m.differences = diffs;
      }

      // Update stored consolidation with refreshed differences
      const savedConsolidation = await db.prepare(
        `SELECT id FROM handicapmaster_consolidation ORDER BY imported_at DESC LIMIT 1`
      ).first<{ id: number }>();
      if (savedConsolidation) {
        await db.prepare(
          `UPDATE handicapmaster_consolidation SET matched_json = ? WHERE id = ?`
        ).bind(JSON.stringify(matched), savedConsolidation.id).run();
      }

      // Update the page result
      result = result || { matched: [], hmNotInCrm: [], crmNotInHm: [], errors: [] };
      result.matched = matched;

      successMessage = `Synced ${updated} member${updated !== 1 ? 's' : ''} from HandicapMaster${skipped > 0 ? ` (${skipped} skipped — no data to sync)` : ''}`;
    } catch (e: any) {
      error = `Sync failed: ${e.message}`;
    }
  } else if (action === 'export-new') {
    // Export CRM members not in HM as HandicapMaster-compatible CSV
    try {
      const idsJson = formData.get('memberIds') as string;
      const memberIds: number[] = JSON.parse(idsJson);

      if (memberIds.length === 0) {
        error = 'No members to export';
      } else {
        const placeholders = memberIds.map(() => '?').join(',');
        const exportMembers = await db.prepare(
          `SELECT * FROM members WHERE id IN (${placeholders}) ORDER BY surname, first_name`
        ).bind(...memberIds).all();

        if (!exportMembers.results || exportMembers.results.length === 0) {
          error = 'No members found to export';
        } else {
          // HandicapMaster import CSV — only fields safe to import
          const csvColumns = [
            'Surname', 'Middle Initials', 'First Name', 'Gender', 'Age Group',
            'Home/Away/Visitor', 'Home Club', 'PIN', 'Title',
            'Address 1', 'Address 2', 'Address 3', 'Address 4', 'Address 5',
            'Telephone 1', 'Telephone 2', 'Telephone 3', 'E-Mail Address',
            'Club Number', 'Category',
            'Date Joined', 'National ID Country', 'National ID',
            'Date of Birth', 'Send Invoice By',
          ];

          const fmtDate = (d: string | null) => {
            if (!d) return ' ';
            const m = d.match(/^(\d{4})-(\d{2})-(\d{2})/);
            return m ? `${m[3]}/${m[2]}/${m[1]}` : d;
          };
          const sanitize = (v: string | null) => v ? v.replace(/[\r\n]+/g, ' ').trim() : ' ';
          const fmtBool = (v: any) => {
            if (v === null || v === undefined || v === '') return ' ';
            if (v === 1 || v === '1' || String(v).toLowerCase() === 'yes') return 'Yes';
            if (v === 0 || v === '0' || String(v).toLowerCase() === 'no') return 'No';
            return String(v);
          };
          const fmtInvoice = (v: string | null) => {
            if (!v) return ' ';
            const l = v.toLowerCase();
            if (l === 'email' || l === 'e-mail' || l === 'e') return 'Email';
            if (l === 'letter' || l === 'l' || l === 'post') return 'Letter';
            return v;
          };
          const escCsv = (v: string) =>
            v.includes(',') || v.includes('"') || v.includes('\n') ? `"${v.replace(/"/g, '""')}"` : v;

          const mapRow = (m: any) => [
            sanitize(m.surname), sanitize(m.middle_initials), sanitize(m.first_name),
            m.gender || ' ', m.age_group || ' ',
            m.home_away || 'H', sanitize(m.home_club) || 'Alnmouth Village',
            m.pin || ' ', m.title || ' ',
            ' ', ' ', ' ', ' ', ' ', // Address 1-5 blanked
            ' ', ' ', ' ', // Telephone 1-3 blanked
            (m.email && /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(m.email)) ? m.email : 'subscriptions@alnmouthvillage.golf', ' ',
            m.category === 'Senior Loyalty' ? 'Senior' : m.category === 'Junior (Members Family)' ? 'Junior' : (m.category || ' '),
            fmtDate(m.date_joined), m.national_id_country || ' ', m.national_id || ' ',
            fmtDate(m.date_of_birth), fmtInvoice(m.send_invoice_by),
          ];

          let csv = csvColumns.join(',') + '\r\n';
          for (const member of exportMembers.results) {
            csv += mapRow(member).map(escCsv).join(',') + '\r\n';
          }

          const filename = `AVGC_New_Members_HM_${new Date().toISOString().split('T')[0]}.csv`;
          return new Response(csv, {
            headers: {
              'Content-Type': 'text/csv; charset=ascii',
              'Content-Disposition': `attachment; filename="${filename}"`,
            },
          });
        }
      }
    } catch (e: any) {
      error = `Export failed: ${e.message}`;
    }
  } else if (action === 'undo-sync') {
    // Undo last sync by restoring saved values
    try {
      const undoData = await db.prepare(
        `SELECT value FROM app_settings WHERE key = 'hm_sync_undo'`
      ).first<{ value: string }>();

      if (!undoData) {
        error = 'No sync to undo — no snapshot found';
      } else {
        const { snapshot, syncedAt } = JSON.parse(undoData.value);
        let restored = 0;

        for (const s of snapshot) {
          await db.prepare(
            `UPDATE members SET handicap_index = ?, competition_fee_purse = ?, home_club = ?, home_away = ?, age_group = ? WHERE id = ?`
          ).bind(s.handicap_index, s.competition_fee_purse, s.home_club, s.home_away, s.age_group, s.id).run();
          restored++;
        }

        // Remove the undo snapshot so it can't be applied twice
        await db.prepare(`DELETE FROM app_settings WHERE key = 'hm_sync_undo'`).run();

        successMessage = `Undo complete — restored ${restored} member${restored !== 1 ? 's' : ''} to pre-sync values (sync from ${new Date(syncedAt).toLocaleDateString('en-GB')})`;
      }
    } catch (e: any) {
      error = `Undo failed: ${e.message}`;
    }
  } else {
    // Process uploaded file
    const file = formData.get('hmfile') as File;

    if (!file || file.size === 0) {
      error = 'Please select a HandicapMaster export CSV file';
    } else {
      try {
        // Read as Windows-1252 (HandicapMaster exports in this encoding, not UTF-8)
        const buffer = await file.arrayBuffer();
        const text = new TextDecoder('windows-1252').decode(buffer);
        const rows = parseCSV(text);

        if (rows.length < 2) {
          error = 'CSV file appears to be empty or has no data rows';
        } else {
          const header = rows[0].map(h => h.toUpperCase());

          // Find column indices
          const colMap: Record<string, number> = {};
          const columns = [
            'SURNAME', 'MIDDLE INITIALS', 'FIRST NAME', 'GENDER', 'AGE GROUP',
            'HANDICAP INDEX', 'HOME/AWAY/VISITOR', 'HOME CLUB', 'PIN', 'TITLE',
            'ADDRESS 1', 'ADDRESS 2', 'ADDRESS 3', 'ADDRESS 4', 'ADDRESS 5',
            'TELEPHONE 1', 'TELEPHONE 2', 'TELEPHONE 3', 'E-MAIL ADDRESS',
            'CLUB NUMBER', 'CATEGORY', 'DATE JOINED', 'DATE RENEWED', 'DATE EXPIRES',
            'DATE SUBSCRIPTION PAID', 'NATIONAL ID COUNTRY', 'NATIONAL ID',
            'DATE OF BIRTH', 'LOCKER NUMBER', 'DEFAULT PAYMENT METHOD',
            'SUBSCRIPTION TEMPLATE', 'ACCOUNT BALANCE', 'SEND INVOICE BY',
            'COMPETITION PURSE', 'COMP PURSE', 'COMPETITION FEE PURSE'
          ];

          for (const col of columns) {
            colMap[col] = header.findIndex(h => h === col);
          }

          // Track unmapped header columns for diagnostics
          const mappedIndices = new Set(Object.values(colMap).filter(i => i >= 0));
          const unmappedHeaders = header
            .map((h, i) => ({ name: h, index: i }))
            .filter(h => !mappedIndices.has(h.index) && h.name.trim());

          if (colMap['SURNAME'] === -1 || colMap['FIRST NAME'] === -1) {
            error = 'CSV file must contain "SURNAME" and "FIRST NAME" columns';
          } else {
            // Parse HandicapMaster records
            const hmRecords: HMRecord[] = [];

            for (let i = 1; i < rows.length; i++) {
              const values = rows[i];
              const surname = getCol(values, colMap['SURNAME']);
              const firstName = getCol(values, colMap['FIRST NAME']);

              if (surname && firstName) {
                hmRecords.push({
                  surname,
                  middleInitials: getCol(values, colMap['MIDDLE INITIALS']),
                  firstName,
                  gender: getCol(values, colMap['GENDER']),
                  ageGroup: getCol(values, colMap['AGE GROUP']),
                  handicapIndex: getCol(values, colMap['HANDICAP INDEX']),
                  homeAway: getCol(values, colMap['HOME/AWAY/VISITOR']),
                  homeClub: getCol(values, colMap['HOME CLUB']),
                  pin: getCol(values, colMap['PIN']),
                  title: getCol(values, colMap['TITLE']),
                  address1: getCol(values, colMap['ADDRESS 1']),
                  address2: getCol(values, colMap['ADDRESS 2']),
                  address3: getCol(values, colMap['ADDRESS 3']),
                  address4: getCol(values, colMap['ADDRESS 4']),
                  address5: getCol(values, colMap['ADDRESS 5']),
                  telephone1: getCol(values, colMap['TELEPHONE 1']),
                  telephone2: getCol(values, colMap['TELEPHONE 2']),
                  telephone3: getCol(values, colMap['TELEPHONE 3']),
                  email: getCol(values, colMap['E-MAIL ADDRESS']),
                  clubNumber: getCol(values, colMap['CLUB NUMBER']),
                  category: getCol(values, colMap['CATEGORY']),
                  dateJoined: getCol(values, colMap['DATE JOINED']),
                  dateRenewed: getCol(values, colMap['DATE RENEWED']),
                  dateExpires: getCol(values, colMap['DATE EXPIRES']),
                  dateSubscriptionPaid: getCol(values, colMap['DATE SUBSCRIPTION PAID']),
                  nationalIdCountry: getCol(values, colMap['NATIONAL ID COUNTRY']),
                  nationalId: getCol(values, colMap['NATIONAL ID']),
                  dateOfBirth: getCol(values, colMap['DATE OF BIRTH']),
                  lockerNumber: getCol(values, colMap['LOCKER NUMBER']),
                  defaultPaymentMethod: getCol(values, colMap['DEFAULT PAYMENT METHOD']),
                  subscriptionTemplate: getCol(values, colMap['SUBSCRIPTION TEMPLATE']),
                  accountBalance: getCol(values, colMap['ACCOUNT BALANCE']),
                  sendInvoiceBy: getCol(values, colMap['SEND INVOICE BY']),
                  competitionPurse: getCol(values, colMap['COMPETITION PURSE']) || getCol(values, colMap['COMP PURSE']) || getCol(values, colMap['COMPETITION FEE PURSE'])
                });
              }
            }

            // Normalise HM data before comparison
            for (const hm of hmRecords) {
              // Replace "Playing Ladies" age group with calculated age group from DOB
              if (hm.ageGroup === 'Playing Ladies') {
                hm.ageGroup = calculateAgeGroup(hm.dateOfBirth);
              }
              // Map "Senior" category to "Senior Loyalty" to match CRM naming
              if (hm.category === 'Senior') {
                hm.category = 'Senior Loyalty';
              }
            }

            // Get all CRM members (exclude Social — they only exist in CRM)
            const crmMembersResult = await db.prepare(
              `SELECT id, first_name, surname, middle_initials, pin, category, email,
                      handicap_index, date_expires, telephone_1, address_1,
                      home_away, home_club, competition_fee_purse, age_group, date_of_birth
               FROM members
               WHERE category != 'Social' AND category IS NOT NULL AND category != ''
               ORDER BY surname, first_name`
            ).all();
            const crmMembers = (crmMembersResult.results || []) as Array<{
              id: number;
              first_name: string;
              surname: string;
              middle_initials: string | null;
              pin: string | null;
              category: string | null;
              email: string | null;
              handicap_index: number | null;
              date_expires: string | null;
              telephone_1: string | null;
              address_1: string | null;
              home_away: string | null;
              home_club: string | null;
              competition_fee_purse: number | null;
              age_group: string | null;
              date_of_birth: string | null;
            }>;

            // Create lookup maps
            const crmById = new Map<number, typeof crmMembers[0]>();
            const crmByPin = new Map<string, typeof crmMembers[0]>();
            const crmByName = new Map<string, typeof crmMembers[0]>();
            for (const member of crmMembers) {
              crmById.set(member.id, member);
              if (member.pin) {
                crmByPin.set(member.pin, member);
              }
              const nameKey = `${normalizeName(member.surname)}|${normalizeName(member.first_name)}`;
              crmByName.set(nameKey, member);
            }

            // Track matched CRM IDs
            const matchedCrmIds = new Set<number>();

            // Build results
            result = {
              matched: [],
              hmNotInCrm: [],
              crmNotInHm: [],
              errors: unmappedHeaders.length > 0
                ? [`Unmapped CSV columns: ${unmappedHeaders.map(h => `"${h.name}" (col ${h.index})`).join(', ')}`]
                : []
            };

            // Process HandicapMaster records
            // Match priority: 1) Club Number = Member ID, 2) PIN, 3) Name
            for (const hm of hmRecords) {
              let crm: typeof crmMembers[0] | null | undefined = null;

              // 1. Try matching Club Number to CRM member ID
              if (hm.clubNumber) {
                const clubNum = parseInt(hm.clubNumber, 10);
                if (!isNaN(clubNum)) {
                  crm = crmById.get(clubNum) || null;
                }
              }

              // 2. Try PIN match
              if (!crm && hm.pin) {
                crm = crmByPin.get(hm.pin) || null;
              }

              // 3. Fall back to name match
              if (!crm) {
                const nameKey = `${normalizeName(hm.surname)}|${normalizeName(hm.firstName)}`;
                crm = crmByName.get(nameKey) || null;
              }

              if (crm) {
                matchedCrmIds.add(crm.id);

                // Check for differences
                const differences: string[] = [];

                if (hm.pin && crm.pin && hm.pin !== crm.pin) {
                  differences.push(`PIN: HM="${hm.pin}" vs CRM="${crm.pin}"`);
                }
                if (hm.email && crm.email && hm.email.toLowerCase() !== crm.email.toLowerCase()) {
                  differences.push(`Email differs`);
                }
                if (hm.handicapIndex && crm.handicap_index !== null) {
                  const hmHcap = parseFloat(hm.handicapIndex);
                  if (!isNaN(hmHcap) && Math.abs(hmHcap - crm.handicap_index) > 0.1) {
                    differences.push(`Handicap: HM="${hm.handicapIndex}" vs CRM="${crm.handicap_index}"`);
                  }
                }
                if (hm.category && crm.category && hm.category !== crm.category) {
                  differences.push(`Category: HM="${hm.category}" vs CRM="${crm.category}"`);
                }
                if (hm.homeAway && crm.home_away && hm.homeAway.charAt(0).toUpperCase() !== crm.home_away) {
                  differences.push(`H/A: HM="${hm.homeAway}" vs CRM="${crm.home_away}"`);
                }
                if (hm.homeClub && crm.home_club && normalizeName(hm.homeClub) !== normalizeName(crm.home_club)) {
                  differences.push(`Home Club: HM="${hm.homeClub}" vs CRM="${crm.home_club}"`);
                }
                const hmAgeGroup = calculateAgeGroup(hm.dateOfBirth);
                // Normalize CRM age group: "Playing Ladies" → calculated from DOB
                const crmAgeGroup = crm.age_group === 'Playing Ladies'
                  ? calculateAgeGroup(crm.date_of_birth)
                  : crm.age_group;
                if (hmAgeGroup && crmAgeGroup && hmAgeGroup !== crmAgeGroup) {
                  differences.push(`Age Group: HM="${hmAgeGroup}" vs CRM="${crm.age_group}"`);
                }
                // Use competition purse field if available, fall back to account balance
                const purseValue = hm.competitionPurse || hm.accountBalance;
                if (purseValue) {
                  const hmPurse = parseCurrency(purseValue);
                  const crmPurse = crm.competition_fee_purse || 0;
                  if (Math.abs(hmPurse - crmPurse) > 0.01) {
                    differences.push(`Comp Purse: HM="£${hmPurse.toFixed(2)}" vs CRM="£${crmPurse.toFixed(2)}"`);
                  }
                }

                result.matched.push({
                  hmRecord: hm,
                  crmId: crm.id,
                  crmName: `${crm.first_name} ${crm.surname}`,
                  crmPin: crm.pin || '',
                  differences
                });
              } else {
                result.hmNotInCrm.push(hm);
              }
            }

            // Find CRM members not in HandicapMaster
            for (const crm of crmMembers) {
              if (!matchedCrmIds.has(crm.id)) {
                result.crmNotInHm.push({
                  crmId: crm.id,
                  crmName: `${crm.first_name} ${crm.surname}`,
                  crmPin: crm.pin || '',
                  crmCategory: crm.category
                });
              }
            }

            // Save results to database
            await db.prepare(
              `INSERT INTO handicapmaster_consolidation (
                matched_count, hm_not_in_crm_count, crm_not_in_hm_count,
                matched_json, hm_not_in_crm_json, crm_not_in_hm_json, errors_json
              ) VALUES (?, ?, ?, ?, ?, ?, ?)`
            ).bind(
              result.matched.length,
              result.hmNotInCrm.length,
              result.crmNotInHm.length,
              JSON.stringify(result.matched),
              JSON.stringify(result.hmNotInCrm),
              JSON.stringify(result.crmNotInHm),
              JSON.stringify(result.errors)
            ).run();

            lastImport = { imported_at: new Date().toISOString(), imported_by: null };
          }
        }
      } catch (e: any) {
        error = `Failed to process file: ${e.message}`;
      }
    }
  }
}

// Get current CRM stats
const crmTotalCount = await db.prepare(
  `SELECT COUNT(*) as count FROM members`
).first<{ count: number }>();

const crmWithPinCount = await db.prepare(
  `SELECT COUNT(*) as count FROM members WHERE pin IS NOT NULL AND pin != ''`
).first<{ count: number }>();

// Calculate discrepancies
const hasDiscrepancies = result ? (
  result.hmNotInCrm.length > 0 ||
  result.crmNotInHm.length > 0 ||
  result.matched.some(m => m.differences.length > 0)
) : false;
